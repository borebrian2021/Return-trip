@model AgentRoutesPageViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Vehicle Routes";
}

<div class="dash-page-header">
    <div>
        <h1><i class="fa fa-route me-2" style="color:#d4890a;font-size:20px;"></i>Vehicle Routes</h1>
        <p class="dash-page-header__sub">Update the current route and return date for each assigned vehicle.</p>
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@if (!Model.Vehicles.Any())
{
    <div class="dash-panel">
        <div class="dash-empty">
            <i class="fa fa-truck"></i>
            <p>No vehicles are currently assigned to your agent profile.</p>
        </div>
    </div>
}
else
{
    @foreach (var vehicle in Model.Vehicles)
    {
        <div class="dash-panel mb-4">
            <div class="dash-panel__header">
                <h2 class="dash-panel__title">@vehicle.NumberPlate <span class="td-muted">· @vehicle.VehicleType · @vehicle.CompanyName</span></h2>
            </div>
            @if (vehicle.IsAwaitingDeposit)
            {
                <div class="alert alert-info">
                    This vehicle is temporarily held for an awarded bid while the goods owner completes the 70% deposit. Route updates and new bids are paused until payment or award cancellation.
                </div>
            }
            else
            {
                @if (vehicle.IsReservedForActiveCargo)
                {
                    <div class="alert alert-info">
                        This vehicle is reserved for a paid cargo booking. You may update its current route, but it will remain unavailable for new bids.
                    </div>
                }
            <form asp-action="UpdateRoute" method="post" class="row g-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="VehicleId" value="@vehicle.VehicleId" />
                <input type="hidden" id="from-place-@vehicle.VehicleId" name="FromPlaceId" value="@vehicle.FromPlaceId" />
                <input type="hidden" id="from-lat-@vehicle.VehicleId" name="FromLatitude" value="@vehicle.FromLatitude" />
                <input type="hidden" id="from-lng-@vehicle.VehicleId" name="FromLongitude" value="@vehicle.FromLongitude" />
                <input type="hidden" id="to-place-@vehicle.VehicleId" name="ToPlaceId" value="@vehicle.ToPlaceId" />
                <input type="hidden" id="to-lat-@vehicle.VehicleId" name="ToLatitude" value="@vehicle.ToLatitude" />
                <input type="hidden" id="to-lng-@vehicle.VehicleId" name="ToLongitude" value="@vehicle.ToLongitude" />

                <div class="col-md-6">
                    <label for="from-@vehicle.VehicleId" class="form-label">From location</label>
                    <div class="route-location-field">
                        <input id="from-@vehicle.VehicleId" name="FromLocation" value="@vehicle.FromLocation" class="form-control route-location-input" maxlength="300" autocomplete="off" required />
                        <ul id="from-options-@vehicle.VehicleId" class="route-place-options" role="listbox" hidden></ul>
                    </div>
                    <small class="form-text text-muted">Search and select a map result to save route coordinates.</small>
                </div>

                <div class="col-md-6">
                    <label for="to-@vehicle.VehicleId" class="form-label">To location</label>
                    <div class="route-location-field">
                        <input id="to-@vehicle.VehicleId" name="ToLocation" value="@vehicle.ToLocation" class="form-control route-location-input" maxlength="300" autocomplete="off" required />
                        <ul id="to-options-@vehicle.VehicleId" class="route-place-options" role="listbox" hidden></ul>
                    </div>
                    <small class="form-text text-muted">Search and select a map result to save route coordinates.</small>
                </div>

                <div class="col-md-6">
                    <label for="departure-@vehicle.VehicleId" class="form-label">Departure date</label>
                    <input id="departure-@vehicle.VehicleId" type="date" name="DepartureDate" value="@vehicle.DepartureDate?.ToString("yyyy-MM-dd")" class="form-control" required />
                </div>

                <div class="col-md-6">
                    <label for="return-@vehicle.VehicleId" class="form-label">Return date</label>
                    <input id="return-@vehicle.VehicleId" type="date" name="ReturnDate" value="@vehicle.ReturnDate?.ToString("yyyy-MM-dd")" class="form-control" required />
                </div>

                <div class="col-12 d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary"><i class="fa fa-save me-2"></i>Update Route</button>
                </div>
            </form>
            }
        </div>
    }
}

@section Styles {
    <style>
        .route-location-field { position: relative; }
        .route-place-options {
            position: absolute;
            z-index: 20;
            top: calc(100% + 4px);
            left: 0;
            right: 0;
            max-height: 240px;
            overflow-y: auto;
            margin: 0;
            padding: 4px;
            list-style: none;
            background: #fff;
            border: 1px solid #dce3df;
            border-radius: 6px;
            box-shadow: 0 8px 20px rgba(20, 38, 31, .14);
        }
        .route-place-options button {
            width: 100%;
            padding: 9px 10px;
            border: 0;
            border-radius: 4px;
            background: transparent;
            color: #303936;
            text-align: left;
            font-size: 13px;
        }
        .route-place-options button:hover,
        .route-place-options button:focus { background: #f1f5f3; outline: none; }
    </style>
}

@section Scripts {
    <script>
        document.querySelectorAll('.route-location-input').forEach(function (input) {
            const id = input.id;
            const side = id.startsWith('from-') ? 'from' : 'to';
            const vehicleId = id.substring(side.length + 1);
            const placeId = document.getElementById(side + '-place-' + vehicleId);
            const latitude = document.getElementById(side + '-lat-' + vehicleId);
            const longitude = document.getElementById(side + '-lng-' + vehicleId);
            const options = document.getElementById(side + '-options-' + vehicleId);
            let searchTimer;

            input.addEventListener('input', function () {
                placeId.value = '';
                latitude.value = '';
                longitude.value = '';
                options.replaceChildren();
                options.hidden = true;
                const query = input.value.trim();
                window.clearTimeout(searchTimer);
                if (query.length < 3) return;

                searchTimer = window.setTimeout(async function () {
                    try {
                        const url = 'https://nominatim.openstreetmap.org/search?format=json&limit=5&q=' + encodeURIComponent(query);
                        const response = await fetch(url, { headers: { 'Accept-Language': 'en' } });
                        if (!response.ok) throw new Error('Location search failed');
                        const places = await response.json();
                        options.replaceChildren();
                        places.forEach(function (place) {
                            const item = document.createElement('li');
                            const button = document.createElement('button');
                            button.type = 'button';
                            button.textContent = place.display_name;
                            button.addEventListener('mousedown', function (event) {
                                event.preventDefault();
                                input.value = place.display_name.split(',').slice(0, 3).join(',').trim();
                                placeId.value = (place.osm_type || 'place') + '/' + place.osm_id;
                                latitude.value = place.lat;
                                longitude.value = place.lon;
                                options.replaceChildren();
                                options.hidden = true;
                            });
                            item.appendChild(button);
                            options.appendChild(item);
                        });
                        options.hidden = places.length === 0;
                    } catch {
                        options.hidden = true;
                    }
                }, 400);
            });

            input.addEventListener('blur', function () {
                window.setTimeout(function () { options.hidden = true; }, 160);
            });
        });
    </script>
}
