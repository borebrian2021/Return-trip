@{
    Layout = "_DashboardLayout";
}

<div class="dash-page-header">
    <h1>@ViewData["Title"]</h1>
</div>

<div class="dash-panel">
    <div class="dash-empty" style="padding:80px 24px;">
        <i class="fa fa-hard-hat" style="font-size:48px;color:#f0a500;opacity:1;margin-bottom:20px;"></i>
        <h3 style="font-size:18px;font-weight:700;color:#2f2f2f;margin-bottom:8px;">Coming Soon</h3>
        <p style="font-size:14px;color:#9a9a9a;max-width:360px;margin:0 auto 24px;">
            This section is under construction and will be ready shortly.
        </p>
        <a asp-action="Dashboard" class="dash-btn dash-btn--primary">
            <i class="fa fa-arrow-left"></i> Back to Dashboard
        </a>
    </div>
</div>
