@model MyListingsViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "My Listings";
}

<div class="dash-page-header">
    <div>
        <h1><i class="fa fa-list me-2" style="color:#1a3c5e;font-size:20px;"></i>My Listings</h1>
        <p class="dash-page-header__sub">All cargo listings you have posted.</p>
    </div>
    <div class="dash-page-header__actions">
        <a asp-action="PostCargo" class="dash-btn dash-btn--primary">
            <i class="fa fa-plus"></i> Post New Cargo
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="dash-alert dash-alert--success mb-4">
        <i class="fa fa-check-circle me-2"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="dash-alert dash-alert--error mb-4">
        <i class="fa fa-exclamation-circle me-2"></i> @TempData["Error"]
    </div>
}

<!-- ── Stat strip ───────────────────────────────────────────────────────────── -->
<div class="listings-stat-strip mb-4">
    <a asp-action="MyListings" class="listings-stat @(Model.FilterStatus == null ? "active" : "")">
        <span class="listings-stat__value">@Model.TotalCount</span>
        <span class="listings-stat__label">Total</span>
    </a>
    <a asp-action="MyListings" asp-route-status="Open" class="listings-stat @(Model.FilterStatus == "Open" ? "active" : "")">
        <span class="listings-stat__value">@Model.OpenCount</span>
        <span class="listings-stat__label">Open</span>
    </a>
    <a asp-action="MyListings" asp-route-status="InTransit" class="listings-stat @(Model.FilterStatus == "InTransit" ? "active" : "")">
        <span class="listings-stat__value">@Model.InTransitCount</span>
        <span class="listings-stat__label">In Transit</span>
    </a>
    <a asp-action="MyListings" asp-route-status="Delivered" class="listings-stat @(Model.FilterStatus == "Delivered" ? "active" : "")">
        <span class="listings-stat__value">@Model.DeliveredCount</span>
        <span class="listings-stat__label">Delivered</span>
    </a>
</div>

<!-- ── Table ─────────────────────────────────────────────────────────────────── -->
<div class="dash-panel">
    <div class="dash-panel__header">
        <h2 class="dash-panel__title">
            @if (Model.FilterStatus != null)
            {
                <span>Showing: <span class="status-pill status-pill--@Model.FilterStatus.ToLower()">@Model.FilterStatus</span></span>
            }
            else
            {
                <span>All Listings</span>
            }
        </h2>
        @if (Model.FilterStatus != null)
        {
            <a asp-action="MyListings" class="dash-panel__action">Clear filter</a>
        }
    </div>

    @if (!Model.Listings.Any())
    {
        <div class="dash-empty">
            <i class="fa fa-box-open"></i>
            <p>@(Model.FilterStatus != null ? $"No {Model.FilterStatus} listings found." : "You haven't posted any cargo yet.")</p>
            <a asp-action="PostCargo" class="dash-btn dash-btn--primary">
                <i class="fa fa-plus"></i> Post your first cargo
            </a>
        </div>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table class="dash-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Cargo</th>
                        <th>Route</th>
                        <th>Weight</th>
                        <th>Cost</th>
                        <th>Bids</th>
                        <th>Status</th>
                        <th>Departs</th>
                        <th>Posted</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Listings)
                    {
                        <tr>
                            <td class="td-muted">@c.Id</td>
                            <td>
                                <div class="td-primary">@c.Title</div>
                                <div class="td-muted">@c.PackageType</div>
                            </td>
                            <td class="td-muted" style="white-space:nowrap;">@c.Route</td>
                            <td class="td-muted">@c.WeightKg.ToString("N0") kg</td>
                            <td>
                                @if (c.PricingMode == "PerKg")
                                {
                                    <div class="td-primary">R @c.PricePerKg?.ToString("N2")/kg</div>
                                    <div class="td-muted">R @c.TransportCost.ToString("N0") total</div>
                                }
                                else
                                {
                                    <div class="td-primary">R @c.TransportCost.ToString("N0")</div>
                                }
                            </td>
                            <td>
                                <div style="display:flex;align-items:center;gap:6px;">
                                    <span class="dash-stat-card__badge dash-stat-card__badge--@(c.BidCount > 0 ? "amber" : "blue")">
                                        @c.BidCount bid@(c.BidCount != 1 ? "s" : "")
                                    </span>
                                    @if (c.AcceptedBidCount > 0)
                                    {
                                        <span class="dash-stat-card__badge dash-stat-card__badge--green">
                                            @c.AcceptedBidCount accepted
                                        </span>
                                    }
                                </div>
                            </td>
                            <td>
                                <span class="status-pill status-pill--@c.Status.ToLower()">@c.Status</span>
                                @if (!c.IsBidOpen && c.Status == "Open")
                                {
                                    <div class="td-muted" style="font-size:10px;margin-top:2px;">Bidding closed</div>
                                }
                            </td>
                            <td class="td-muted" style="white-space:nowrap;">
                                @(c.RequiredDepartureAt.HasValue
                                    ? c.RequiredDepartureAt.Value.ToString("dd MMM yyyy")
                                    : "—")
                            </td>
                            <td class="td-muted" style="white-space:nowrap;">
                                @c.CreatedAt.ToString("dd MMM yyyy")
                            </td>
                            <td>
                                <div style="display:flex;gap:6px;flex-wrap:nowrap;">
                                    @if (c.Status == "Open")
                                    {
                                        <form asp-action="ToggleBidding" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@c.Id">
                                            <button type="submit"
                                                    class="dash-btn dash-btn--outline"
                                                    style="padding:5px 10px;font-size:11px;"
                                                    title="@(c.IsBidOpen ? "Close bidding" : "Reopen bidding")">
                                                <i class="fa @(c.IsBidOpen ? "fa-lock" : "fa-lock-open")"></i>
                                                @(c.IsBidOpen ? "Close" : "Reopen")
                                            </button>
                                        </form>
                                    }
                                    @if (c.AcceptedBidCount == 0)
                                    {
                                        <form asp-action="DeleteCargo" method="post" style="display:inline;"
                                              onsubmit="return confirm('Delete \'@c.Title\'? This cannot be undone.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@c.Id">
                                            <button type="submit"
                                                    class="dash-btn dash-btn--outline"
                                                    style="padding:5px 10px;font-size:11px;color:#c0392b;border-color:#f5c6c3;">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Styles {
<style>
/* stat strip */
.listings-stat-strip {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
}
.listings-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 14px 28px;
    background: #ffffff;
    border-radius: 12px;
    border: 1.5px solid #e8eceb;
    text-decoration: none;
    transition: .2s;
    min-width: 90px;
}
.listings-stat:hover { border-color: #1a3c5e; text-decoration: none; }
.listings-stat.active { border-color: #1a3c5e; background: #eef3f7; }
.listings-stat__value {
    font-size: 26px;
    font-weight: 800;
    color: #2f2f2f;
    line-height: 1;
}
.listings-stat.active .listings-stat__value { color: #1a3c5e; }
.listings-stat__label { font-size: 11px; font-weight: 600; color: #9a9a9a; margin-top: 4px; text-transform: uppercase; letter-spacing: .4px; }

/* alert success */
.dash-alert--success { background: #e6f4ee; color: #1a7a45; border: 1px solid #b7dfc8; }
</style>
}
