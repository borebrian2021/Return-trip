@model PostCargoViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Post Cargo";
    var googleMapsKey = ViewData["GoogleMapsKey"] as string ?? string.Empty;
}

<div class="dash-page-header">
    <div>
        <h1><i class="fa fa-plus-circle me-2" style="color:#1a3c5e;font-size:20px;"></i>Post Cargo</h1>
        <p class="dash-page-header__sub">Fill in the details below to post a new freight listing for bidding.</p>
    </div>
    <div class="dash-page-header__actions">
        <a asp-action="MyListings" class="dash-btn dash-btn--outline">
            <i class="fa fa-arrow-left"></i> My Listings
        </a>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="dash-alert dash-alert--error mb-4">
        <i class="fa fa-exclamation-circle me-2"></i>
        <div asp-validation-summary="ModelOnly"></div>
    </div>
}

<form asp-action="PostCargo" method="post" id="postCargoForm">
    @Html.AntiForgeryToken()

    <!-- hidden geo fields populated by Nominatim autocomplete -->
    <input asp-for="FromPlaceId"            type="hidden" id="FromPlaceId">
    <input asp-for="FromLatitude"           type="hidden" id="FromLatitude">
    <input asp-for="FromLongitude"          type="hidden" id="FromLongitude">
    <input asp-for="ToPlaceId"              type="hidden" id="ToPlaceId">
    <input asp-for="ToLatitude"             type="hidden" id="ToLatitude">
    <input asp-for="ToLongitude"            type="hidden" id="ToLongitude">
    <input asp-for="DistanceAutoCalculated" type="hidden" id="DistanceAutoCalculated">

    <div class="row g-4">

        <!-- ── Left column ───────────────────────────────────────────────── -->
        <div class="col-lg-8">

            <!-- Cargo details -->
            <div class="dash-panel mb-4">
                <div class="dash-panel__header">
                    <h2 class="dash-panel__title">
                        <i class="fa fa-box-open me-2" style="color:#1a3c5e;"></i>Cargo Details
                    </h2>
                </div>
                <div class="post-cargo-body">

                    <div class="post-field">
                        <label asp-for="Title">Cargo Title</label>
                        <input asp-for="Title" class="form-control"
                               placeholder="e.g. Construction sand – 20 tons" />
                        <span asp-validation-for="Title" class="post-field-error"></span>
                    </div>

                    <div class="post-field">
                        <label asp-for="Description">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3"
                                  placeholder="Additional details, handling requirements, special instructions…"></textarea>
                        <span asp-validation-for="Description" class="post-field-error"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="post-field">
                                <label asp-for="PackageType">Package / Cargo Type</label>
                                <select asp-for="PackageType" class="form-control" id="PackageTypeSelect">
                                    <option value="">— Select type —</option>
                                    <optgroup label="Bulk">
                                        <option value="Bulk – Loose">Bulk – Loose</option>
                                        <option value="Bulk – Bagged">Bulk – Bagged</option>
                                        <option value="Bulk – Liquid">Bulk – Liquid</option>
                                    </optgroup>
                                    <optgroup label="Palletised">
                                        <option value="Palletised – Standard">Palletised – Standard</option>
                                        <option value="Palletised – Euro">Palletised – Euro</option>
                                    </optgroup>
                                    <optgroup label="Specialised">
                                        <option value="Refrigerated">Refrigerated</option>
                                        <option value="Hazardous (ADR)">Hazardous (ADR)</option>
                                        <option value="Oversized / Out-of-gauge">Oversized / Out-of-gauge</option>
                                        <option value="Machinery / Plant">Machinery / Plant</option>
                                        <option value="Livestock">Livestock</option>
                                        <option value="Vehicles">Vehicles</option>
                                        <option value="Groupage / Part load">Groupage / Part load</option>
                                    </optgroup>
                                    <option value="Other">Other</option>
                                </select>
                                <span asp-validation-for="PackageType" class="post-field-error"></span>
                            </div>

                            <!-- "Other" free-text input — shown only when Other is selected -->
                            <div class="post-field d-none" id="otherTypeWrap">
                                <label for="OtherPackageType">Describe cargo type</label>
                                <input type="text" id="OtherPackageType" class="form-control"
                                       placeholder="e.g. Timber offcuts" maxlength="150" />
                                <small>This will be saved as the cargo type.</small>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="post-field">
                                <label asp-for="WeightTonnes">Weight (tonnes)</label>
                                <div class="tonnage-slider">
                                    <input asp-for="WeightTonnes" class="form-range" type="range"
                                           min="0.2" max="30" step="0.1" id="WeightTonnes" />
                                    <output id="WeightTonnesOutput" for="WeightTonnes">0.2 tonnes</output>
                                </div>
                                <small>Choose between 200 kg and 30 tonnes.</small>
                                <span asp-validation-for="WeightTonnes" class="post-field-error"></span>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Route -->
            <div class="dash-panel mb-4">
                <div class="dash-panel__header">
                    <h2 class="dash-panel__title">
                        <i class="fa fa-route me-2" style="color:#0e7490;"></i>Route &amp; Distance
                    </h2>
                </div>
                <div class="post-cargo-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="post-field">
                                <label asp-for="FromLocation">
                                    <i class="fa fa-map-marker-alt me-1" style="color:#1a3c5e;"></i>Pickup Location
                                </label>
                                <div class="location-input-wrap">
                                    <input asp-for="FromLocation" class="form-control location-autocomplete"
                                           id="FromLocation" autocomplete="off"
                                           placeholder="Start typing a city or address…" />
                                    <i class="fa fa-search location-input-icon"></i>
                                </div>
                                <small>Type to search or enter manually.</small>
                                <span asp-validation-for="FromLocation" class="post-field-error"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="post-field">
                                <label asp-for="ToLocation">
                                    <i class="fa fa-map-marker-alt me-1" style="color:#c0392b;"></i>Delivery Location
                                </label>
                                <div class="location-input-wrap">
                                    <input asp-for="ToLocation" class="form-control location-autocomplete"
                                           id="ToLocation" autocomplete="off"
                                           placeholder="Start typing a city or address…" />
                                    <i class="fa fa-search location-input-icon"></i>
                                </div>
                                <small>Type to search or enter manually.</small>
                                <span asp-validation-for="ToLocation" class="post-field-error"></span>
                            </div>
                        </div>
                    </div>

                    <div class="route-match-panel" id="route-match-panel" aria-live="polite">
                        <div class="route-match-panel__heading">
                            <div>
                                <strong>Vehicles on this route</strong>
                                <span>Matches are within 30 km of both selected endpoints.</span>
                            </div>
                            <i class="fa fa-truck-fast" aria-hidden="true"></i>
                        </div>
                        <p class="route-match-message" id="route-match-message">Select pickup and delivery locations from the map suggestions to see matches.</p>
                        <ul class="route-match-results" id="route-match-results"></ul>
                    </div>

                    <!-- Distance row -->
                    <div class="row g-3 mt-1" id="distance-row">
                        <div class="col-md-6">
                            <div class="post-field">
                                <label asp-for="DistanceKm">
                                    <i class="fa fa-road me-1" style="color:#0e7490;"></i>Distance (km)
                                </label>
                                <div class="input-with-prefix">
                                    <span class="input-prefix" style="font-size:11px;font-weight:600;">km</span>
                                    <input asp-for="DistanceKm" class="form-control" type="number"
                                           id="DistanceKm" min="0.1" step="0.1"
                                           placeholder="e.g. 475" style="padding-left:38px;" />
                                </div>
                                <small id="distance-hint">
                                    Enter distance manually, or select both locations from the dropdown to auto-calculate.
                                </small>
                                <span asp-validation-for="DistanceKm" class="post-field-error"></span>
                            </div>
                        </div>
                        <div class="col-md-6 d-flex align-items-center">
                            <div id="distance-auto-badge" class="d-none"
                                 style="background:#e6f4ee;border-radius:8px;padding:10px 14px;font-size:12px;color:#1a7a45;width:100%;">
                                <i class="fa fa-check-circle me-2"></i>
                                <strong>Auto-calculated</strong> from map coordinates.
                                <a href="#" id="override-distance" style="color:#1a3c5e;font-size:11px;margin-left:6px;">Override</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Schedule -->
            <div class="dash-panel mb-4">
                <div class="dash-panel__header">
                    <h2 class="dash-panel__title">
                        <i class="fa fa-clock me-2" style="color:#7c3aed;"></i>Schedule &amp; Deadlines
                    </h2>
                </div>
                <div class="post-cargo-body">
                    <div class="schedule-urgent-notice">
                        <i class="fa fa-exclamation-triangle me-2"></i>
                        All times are critical — especially for perishable goods. Missed pickups may result in bid cancellation.
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <div class="post-field">
                                <label asp-for="PickupDateTime">
                                    <i class="fa fa-calendar-check me-1" style="color:#1a3c5e;"></i>
                                    Scheduled Pickup Date &amp; Time <span style="color:#c0392b;">*</span>
                                </label>
                                <input asp-for="PickupDateTime" class="form-control" type="datetime-local"
                                       min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                                <small>Exact time you need the driver to collect the cargo.</small>
                                <span asp-validation-for="PickupDateTime" class="post-field-error"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="post-field">
                                <label asp-for="PickupDeadlineAt">
                                    <i class="fa fa-exclamation-circle me-1" style="color:#c0392b;"></i>
                                    Latest Pickup By (Hard Deadline) <span style="color:#c0392b;">*</span>
                                </label>
                                <input asp-for="PickupDeadlineAt" class="form-control" type="datetime-local"
                                       min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                                <small>After this time the listing may be reopened for rebidding.</small>
                                <span asp-validation-for="PickupDeadlineAt" class="post-field-error"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="post-field">
                                <label asp-for="DeliveryDeadlineAt">
                                    <i class="fa fa-flag-checkered me-1" style="color:#0e7490;"></i>
                                    Delivery Must Complete By
                                </label>
                                <input asp-for="DeliveryDeadlineAt" class="form-control" type="datetime-local"
                                       min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                                <small>Optional — set for time-sensitive or perishable cargo.</small>
                                <span asp-validation-for="DeliveryDeadlineAt" class="post-field-error"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Contacts -->
            <div class="dash-panel mb-4">
                <div class="dash-panel__header">
                    <h2 class="dash-panel__title">
                        <i class="fa fa-address-book me-2" style="color:#1a3c5e;"></i>Contacts
                    </h2>
                </div>
                <div class="post-cargo-body">

                    <div class="contacts-section-label">
                        <i class="fa fa-user me-2" style="color:#1a3c5e;"></i>Sender (Your Details)
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="post-field">
                                <label asp-for="SenderContactName">Contact Name</label>
                                <input asp-for="SenderContactName" class="form-control"
                                       placeholder="Full name" autocomplete="name" />
                                <span asp-validation-for="SenderContactName" class="post-field-error"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="post-field">
                                <label asp-for="SenderPhone">Phone Number</label>
                                <input asp-for="SenderPhone" class="form-control" type="tel"
                                       placeholder="+254 7xx xxx xxx" autocomplete="tel" />
                                <span asp-validation-for="SenderPhone" class="post-field-error"></span>
                            </div>
                        </div>
                    </div>

                    <div class="contacts-section-label mt-3">
                        <i class="fa fa-user-check me-2" style="color:#0e7490;"></i>Receiver at Destination
                        <span class="contacts-reveal-note">
                            <i class="fa fa-lock me-1"></i>Revealed to driver only after 70% advance payment
                        </span>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="post-field">
                                <label asp-for="ReceiverName">Receiver Name</label>
                                <input asp-for="ReceiverName" class="form-control"
                                       placeholder="Full name of person receiving" />
                                <span asp-validation-for="ReceiverName" class="post-field-error"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="post-field">
                                <label asp-for="ReceiverPhone">Receiver Phone</label>
                                <input asp-for="ReceiverPhone" class="form-control" type="tel"
                                       placeholder="+254 7xx xxx xxx" />
                                <span asp-validation-for="ReceiverPhone" class="post-field-error"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="post-field">
                                <label asp-for="ReceiverEmail">Receiver Email <small style="font-weight:400;text-transform:none;">(optional)</small></label>
                                <input asp-for="ReceiverEmail" class="form-control" type="email"
                                       placeholder="receiver@example.com" />
                                <span asp-validation-for="ReceiverEmail" class="post-field-error"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Pricing -->
            <div class="dash-panel mb-4">
                <div class="dash-panel__header">
                    <h2 class="dash-panel__title">
                        <i class="fa fa-coins me-2" style="color:#d4890a;"></i>Pricing
                    </h2>
                </div>
                <div class="post-cargo-body">

                    <div class="post-field">
                        <label>Pricing Mode</label>
                        <div class="pricing-mode-toggle">
                            <label class="pricing-mode-option @(Model.PricingMode == "FixedTotal" ? "selected" : "")">
                                <input type="radio" asp-for="PricingMode" value="FixedTotal" class="d-none pricing-radio">
                                <i class="fa fa-tag me-2"></i>Fixed Total
                                <small>One quoted price for the full load</small>
                            </label>
                            <label class="pricing-mode-option @(Model.PricingMode == "PerKg" ? "selected" : "")">
                                <input type="radio" asp-for="PricingMode" value="PerKg" class="d-none pricing-radio">
                                <i class="fa fa-weight-hanging me-2"></i>Per Kg
                                <small>Rate × weight = total cost</small>
                            </label>
                        </div>
                    </div>

                    <!-- fixed total -->
                    <div id="field-fixed" class="@(Model.PricingMode == "FixedTotal" ? "" : "d-none")">
                        <div class="post-field">
                            <label asp-for="TransportCost">Total Transport Cost (KSh)</label>
                            <div class="input-with-prefix">
                                <span class="input-prefix">KSh</span>
                                <input asp-for="TransportCost" class="form-control" type="number"
                                       min="0.01" step="0.01" placeholder="e.g. 8500.00"
                                       style="padding-left:46px;" />
                            </div>
                            <span asp-validation-for="TransportCost" class="post-field-error"></span>
                        </div>
                    </div>

                    <!-- per kg -->
                    <div id="field-perkg" class="@(Model.PricingMode == "PerKg" ? "" : "d-none")">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="post-field">
                                    <label asp-for="PricePerKg">Price Per Kg (KSh)</label>
                                    <div class="input-with-prefix">
                                        <span class="input-prefix">KSh</span>
                                        <input asp-for="PricePerKg" class="form-control" type="number"
                                               min="0.01" step="0.01" placeholder="e.g. 0.60"
                                               style="padding-left:46px;" />
                                    </div>
                                    <span asp-validation-for="PricePerKg" class="post-field-error"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="post-field">
                                    <label>Calculated Total</label>
                                    <div class="form-control post-calculated-total" id="calcTotal">—</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="post-commission-info">
                        <i class="fa fa-info-circle me-2"></i>
                        Platform commission: <strong>@Model.CommissionPercent%</strong>.
                        Deducted before payment is released to the vehicle owner.
                    </div>

                </div>
            </div>

        </div>

        <!-- ── Right column ───────────────────────────────────────────────── -->
        <div class="col-lg-4">

            <!-- Payment terms -->
            <div class="dash-panel mb-4">
                <div class="dash-panel__header">
                    <h2 class="dash-panel__title">
                        <i class="fa fa-shield-alt me-2" style="color:#7c3aed;"></i>Payment Terms
                    </h2>
                </div>
                <div class="post-cargo-body">

                    <div class="post-field">
                        <label asp-for="AdvancePaymentPercent">
                            Advance to Driver on Departure
                        </label>
                        <div class="input-with-prefix">
                            <span class="input-prefix">%</span>
                            <input asp-for="AdvancePaymentPercent" class="form-control"
                                   value="70" readonly style="padding-left:30px;background:#f7f9f8;color:#1a3c5e;font-weight:700;" />
                        </div>
                        <small>Fixed at 70% — paid upfront when cargo departs.</small>
                    </div>

                    <div class="post-field">
                        <label asp-for="RetentionPeriodDays">
                            Payment Retention Period (days)
                        </label>
                        <input asp-for="RetentionPeriodDays" class="form-control" type="number"
                               min="3" max="90" step="1" />
                           <small>Remaining 30% held for at least 3 days after delivery before offloading.</small>
                        <span asp-validation-for="RetentionPeriodDays" class="post-field-error"></span>
                    </div>

                </div>
            </div>

            <!-- Summary -->
            <div class="dash-panel post-summary-card mb-4">
                <div class="dash-panel__header">
                    <h2 class="dash-panel__title">
                        <i class="fa fa-receipt me-2" style="color:#1a3c5e;"></i>Summary
                    </h2>
                </div>
                <div class="post-cargo-body">
                    <div class="summary-row">
                        <span>Cargo type</span>
                        <strong id="sum-type">—</strong>
                    </div>
                    <div class="summary-row">
                        <span>Weight</span>
                        <strong id="sum-weight">—</strong>
                    </div>
                    <div class="summary-row">
                        <span>Route</span>
                        <strong id="sum-route">—</strong>
                    </div>
                    <div class="summary-row">
                        <span>Transport cost</span>
                        <strong id="sum-cost">—</strong>
                    </div>
                    <div class="summary-row">
                        <span>Commission (@Model.CommissionPercent%)</span>
                        <strong id="sum-commission" style="color:#c0392b;">—</strong>
                    </div>
                    <div class="summary-row summary-row--total">
                        <span>Net to vehicle owner</span>
                        <strong id="sum-net">—</strong>
                    </div>
                    <div class="summary-row">
                        <span>Advance on departure (70%)</span>
                        <strong id="sum-advance">—</strong>
                    </div>
                    <div class="summary-row">
                        <span>Balance after delivery</span>
                        <strong id="sum-balance">—</strong>
                    </div>
                </div>
            </div>

            <div class="terms-gate">
                <button type="button" class="terms-link" id="openTerms">Click here to see terms and conditions</button>
                <label class="terms-check">
                    <input asp-for="TermsAccepted" id="TermsAccepted" type="checkbox" />
                    <span>I agree to the terms and conditions.</span>
                </label>
                <span asp-validation-for="TermsAccepted" class="post-field-error"></span>
            </div>

            <!-- Terms modal -->
            <div class="terms-modal" id="termsModal" hidden>
                <div class="terms-modal__backdrop" data-close-terms></div>
                <div class="terms-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="termsTitle">
                    <button type="button" class="terms-modal__close" data-close-terms aria-label="Close terms">&times;</button>
                    <h2 id="termsTitle">Terms and Conditions</h2>
                    <div class="terms-modal__body">
                        <p>Terms and conditions content will be added here.</p>
                    </div>
                    <button type="button" class="dash-btn dash-btn--primary" data-close-terms>Close</button>
                </div>
            </div>

            <!-- Submit -->
            <button type="submit" class="dash-btn dash-btn--primary w-100"
                    id="submitCargoButton" disabled style="justify-content:center;padding:14px 0;font-size:15px;">
                <i class="fa fa-paper-plane me-2"></i>Post Cargo Listing
            </button>
            <a asp-action="Dashboard" class="dash-btn dash-btn--outline w-100 mt-2"
               style="justify-content:center;">
                Cancel
            </a>

        </div>
    </div>
</form>

@section Styles {
<style>
.post-cargo-body { padding: 20px 22px 24px; }
.post-field { margin-bottom: 18px; }
.post-field label {
    display: block;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .5px;
    color: #6a6a6a;
    margin-bottom: 6px;
}
.post-field .form-control {
    height: 44px;
    border-radius: 8px;
    border: 1.5px solid #e0e4e3;
    font-size: 14px;
}
.post-field textarea.form-control { height: auto; }
.post-field .form-control:focus {
    border-color: #1a3c5e;
    box-shadow: 0 0 0 3px rgba(26,60,94,.08);
}
.post-field-error { font-size: 12px; color: #c0392b; margin-top: 4px; display: block; }
.post-field small  { display: block; font-size: 11px; color: #b0b0b0; margin-top: 4px; }
.tonnage-slider { display: flex; align-items: center; gap: 14px; }
.tonnage-slider .form-range { flex: 1; accent-color: #1a3c5e; }
.tonnage-slider output { min-width: 82px; color: #1a3c5e; font-size: 14px; font-weight: 800; text-align: right; }
.terms-gate { margin: 4px 0 16px; padding: 14px 16px; background: #f7f9f8; border: 1px solid #e3eae6; border-radius: 8px; }
.terms-link { padding: 0; border: 0; background: none; color: #1a3c5e; font-size: 13px; font-weight: 700; text-decoration: underline; cursor: pointer; }
.terms-check { display: flex; align-items: center; gap: 8px; margin: 12px 0 0; color: #59645f; font-size: 13px; cursor: pointer; }
.terms-check input { width: 16px; height: 16px; accent-color: #1a3c5e; }
.terms-modal[hidden] { display: none; }
.terms-modal { position: fixed; inset: 0; z-index: 1100; display: grid; place-items: center; padding: 20px; }
.terms-modal__backdrop { position: absolute; inset: 0; background: rgba(21, 32, 46, .52); }
.terms-modal__dialog { position: relative; width: min(520px, 100%); padding: 26px; background: #fff; border-radius: 12px; box-shadow: 0 18px 50px rgba(0,0,0,.22); }
.terms-modal__dialog h2 { margin: 0 0 14px; color: #2f2f2f; font-size: 20px; }
.terms-modal__body { min-height: 120px; padding: 16px; background: #f7f9f8; color: #6a6a6a; font-size: 13px; }
.terms-modal__close { position: absolute; top: 10px; right: 14px; border: 0; background: none; color: #6a6a6a; font-size: 24px; cursor: pointer; }

/* location input */
.location-input-wrap { position: relative; }
.location-input-wrap .form-control { padding-right: 36px; }
.route-match-panel {
    margin: 10px 0 18px;
    padding: 15px 16px;
    background: #f7f9f8;
    border: 1px solid #e3eae6;
    border-radius: 8px;
}
.route-match-panel__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: #263a32;
    font-size: 13px;
}
.route-match-panel__heading div { display: grid; gap: 3px; }
.route-match-panel__heading span,
.route-match-message { color: #78837e; font-size: 11px; margin: 0; }
.route-match-panel__heading > i { color: #0e7490; font-size: 17px; }
.route-match-results { display: grid; gap: 7px; margin: 10px 0 0; padding: 0; list-style: none; }
.route-match-result {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 12px;
    background: #fff;
    border: 1px solid #e8eceb;
    border-radius: 6px;
    color: #303936;
    font-size: 12px;
}
.route-match-result__main { min-width: 0; }
.route-match-result__main strong { display: block; color: #1a3c5e; font-size: 13px; }
.route-match-result__main span { display: block; margin-top: 3px; color: #78837e; }
.route-match-result__distance { flex: 0 0 auto; color: #1a7a45; font-size: 11px; font-weight: 700; text-align: right; }
.route-match-message { margin-top: 10px; }
.location-input-icon {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: #b0b0b0;
    font-size: 13px;
    pointer-events: none;
}
/* Google autocomplete dropdown matches our style */
.pac-container {
    border-radius: 8px;
    border: 1.5px solid #e0e4e3;
    box-shadow: 0 8px 24px rgba(0,0,0,.1);
    font-family: "Inter", sans-serif;
    font-size: 13px;
    margin-top: 2px;
}
.pac-item { padding: 8px 12px; cursor: pointer; }
.pac-item:hover, .pac-item-selected { background: #eef3f7; }
.pac-item-query { font-weight: 600; color: #2f2f2f; }
.pac-matched { color: #1a3c5e; }

/* pricing toggle */
.pricing-mode-toggle { display: flex; gap: 10px; }
.pricing-mode-option {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 12px 16px;
    border: 1.5px solid #e0e4e3;
    border-radius: 10px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    color: #6a6a6a;
    transition: .2s;
}
.pricing-mode-option small { font-size: 11px; font-weight: 400; color: #b0b0b0; }
.pricing-mode-option.selected { border-color: #1a3c5e; background: #eef3f7; color: #1a3c5e; }
.pricing-mode-option.selected small { color: #5a7a9a; }

/* input prefix */
.input-with-prefix { position: relative; }
.input-prefix {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 12px;
    font-weight: 700;
    color: #9a9a9a;
    z-index: 2;
    white-space: nowrap;
}

.post-commission-info {
    background: #eef3f7;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 12px;
    color: #5a7a9a;
    margin-top: 4px;
}

/* summary */
.summary-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 0;
    font-size: 13px;
    border-bottom: 1px solid #f4f6f5;
    color: #6a6a6a;
}
.summary-row:last-child { border-bottom: none; }
.summary-row strong { color: #2f2f2f; font-size: 13px; }
.summary-row--total {
    background: #f7f9f8;
    margin: 4px -22px;
    padding: 10px 22px;
    border-bottom: none;
}
.summary-row--total strong { color: #1a3c5e; font-size: 15px; font-weight: 800; }
.post-calculated-total {
    background: #f7f9f8;
    color: #1a3c5e;
    font-weight: 700;
    height: 44px;
    display: flex;
    align-items: center;
    padding-left: 12px;
}

.dash-alert { display: flex; align-items: flex-start; gap: 10px; padding: 14px 18px;
    border-radius: 10px; font-size: 13px; }
.dash-alert--error { background: #fdecea; color: #c0392b; border: 1px solid #f5c6c3; }
</style>
}

@section Scripts {
<partial name="_ValidationScriptsPartial" />

<!-- Nominatim (OpenStreetMap) autocomplete — no API key required -->
<script>
(function () {
    // ── Nominatim autocomplete factory ───────────────────────────────────────
    function makeAutocomplete(inputId, placeIdField, latField, lngField, onSelected) {
        const input     = document.getElementById(inputId);
        const placeEl   = document.getElementById(placeIdField);
        const latEl     = document.getElementById(latField);
        const lngEl     = document.getElementById(lngField);

        // create dropdown container
        const dropdown = document.createElement('ul');
        dropdown.className = 'nominatim-dropdown';
        input.parentNode.appendChild(dropdown);

        let debounceTimer;

        input.addEventListener('input', function () {
            // clear geo fields on manual edit
            placeEl.value = '';
            latEl.value   = '';
            lngEl.value   = '';
            if (typeof onSelected === 'function') onSelected();

            const q = this.value.trim();
            clearTimeout(debounceTimer);

            if (q.length < 3) { dropdown.innerHTML = ''; dropdown.style.display = 'none'; return; }

            debounceTimer = setTimeout(function () {
                fetch('https://nominatim.openstreetmap.org/search?format=json&limit=6&addressdetails=1&q=' +
                      encodeURIComponent(q), {
                    headers: { 'Accept-Language': 'en' }
                })
                .then(function (r) { return r.json(); })
                .then(function (results) {
                    dropdown.innerHTML = '';
                    if (!results.length) { dropdown.style.display = 'none'; return; }

                    results.forEach(function (place) {
                        const li = document.createElement('li');
                        li.className = 'nominatim-item';
                        // show a short version: first two parts of display_name
                        const parts = place.display_name.split(',');
                        const short = parts.slice(0, 3).join(',').trim();
                        li.innerHTML =
                            '<span class="nominatim-primary">' + (parts[0] || '').trim() + '</span>' +
                            '<span class="nominatim-secondary">' + parts.slice(1, 3).join(',').trim() + '</span>';
                        li.addEventListener('mousedown', function (e) {
                            e.preventDefault(); // stop blur firing before click
                            input.value   = short;
                            placeEl.value = place.osm_type + '/' + place.osm_id;
                            latEl.value   = place.lat;
                            lngEl.value   = place.lon;
                            dropdown.innerHTML = '';
                            dropdown.style.display = 'none';
                            if (typeof updateSummary === 'function') updateSummary();
                            if (typeof onSelected === 'function') onSelected();
                        });
                        dropdown.appendChild(li);
                    });
                    dropdown.style.display = 'block';
                })
                .catch(function () { dropdown.style.display = 'none'; });
            }, 350); // debounce 350ms — be polite to Nominatim
        });

        // hide on blur
        input.addEventListener('blur', function () {
            setTimeout(function () { dropdown.style.display = 'none'; }, 200);
        });
        input.addEventListener('focus', function () {
            if (dropdown.children.length) dropdown.style.display = 'block';
        });
    }

    // ── Auto-calculate distance using Haversine formula ─────────────────────
    function haversineKm(lat1, lon1, lat2, lon2) {
        const R = 6371;
        const dLat = (lat2 - lat1) * Math.PI / 180;
        const dLon = (lon2 - lon1) * Math.PI / 180;
        const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                  Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                  Math.sin(dLon/2) * Math.sin(dLon/2);
        return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
    }

    function tryAutoDistance() {
        const lat1 = parseFloat(document.getElementById('FromLatitude').value);
        const lng1 = parseFloat(document.getElementById('FromLongitude').value);
        const lat2 = parseFloat(document.getElementById('ToLatitude').value);
        const lng2 = parseFloat(document.getElementById('ToLongitude').value);
        if (!isNaN(lat1) && !isNaN(lng1) && !isNaN(lat2) && !isNaN(lng2)) {
            const km = haversineKm(lat1, lng1, lat2, lng2);
            document.getElementById('DistanceKm').value = Math.round(km * 10) / 10;
            document.getElementById('DistanceAutoCalculated').value = 'true';
            document.getElementById('distance-auto-badge').classList.remove('d-none');
            document.getElementById('distance-hint').classList.add('d-none');
        }
    }

    const routeMatchMessage = document.getElementById('route-match-message');
    const routeMatchResults = document.getElementById('route-match-results');
    const routeMatchesUrl = '@Url.Action("AvailableVehicles", "GoodsOwner")';
    let routeMatchRequest;

    function refreshRouteMatches() {
        const fromLatitude = document.getElementById('FromLatitude').value;
        const fromLongitude = document.getElementById('FromLongitude').value;
        const toLatitude = document.getElementById('ToLatitude').value;
        const toLongitude = document.getElementById('ToLongitude').value;

        routeMatchRequest?.abort();
        routeMatchResults.replaceChildren();
        if (!fromLatitude || !fromLongitude || !toLatitude || !toLongitude) {
            routeMatchMessage.textContent = 'Select pickup and delivery locations from the map suggestions to see matches.';
            return;
        }

        routeMatchMessage.textContent = 'Checking current vehicle routes…';
        const params = new URLSearchParams({ fromLatitude, fromLongitude, toLatitude, toLongitude });
        const pickupDate = document.getElementById('PickupDateTime')?.value;
        if (pickupDate) params.set('pickupDateTime', pickupDate);
        routeMatchRequest = new AbortController();

        fetch(routeMatchesUrl + '?' + params.toString(), { signal: routeMatchRequest.signal })
            .then(function (response) {
                if (!response.ok) throw new Error('Could not load route matches.');
                return response.json();
            })
            .then(function (vehicles) {
                routeMatchResults.replaceChildren();
                if (!vehicles.length) {
                    routeMatchMessage.textContent = 'No current vehicle routes match both locations and the selected pickup date.';
                    return;
                }

                routeMatchMessage.textContent = vehicles.length + ' vehicle' + (vehicles.length === 1 ? '' : 's') + ' match this route.';
                vehicles.forEach(function (vehicle) {
                    const item = document.createElement('li');
                    item.className = 'route-match-result';
                    const main = document.createElement('div');
                    main.className = 'route-match-result__main';
                    const title = document.createElement('strong');
                    title.textContent = vehicle.numberPlate + ' · ' + vehicle.vehicleType;
                    const route = document.createElement('span');
                    route.textContent = vehicle.direction + ' · ' + vehicle.companyName + ' · ' + vehicle.fromLocation + ' to ' + vehicle.toLocation;
                    const dates = document.createElement('span');
                    dates.textContent = 'Departure ' + new Date(vehicle.departureDate).toLocaleDateString() + ' · Return ' + new Date(vehicle.returnDate).toLocaleDateString();
                    main.append(title, route, dates);
                    const distance = document.createElement('div');
                    distance.className = 'route-match-result__distance';
                    distance.textContent = vehicle.pickupDistanceKm + ' km pickup · ' + vehicle.deliveryDistanceKm + ' km delivery';
                    item.append(main, distance);
                    routeMatchResults.appendChild(item);
                });
            })
            .catch(function (error) {
                if (error.name !== 'AbortError') {
                    routeMatchMessage.textContent = 'Vehicle route matches are temporarily unavailable.';
                }
            });
    }

    function onLocationSelected() {
        tryAutoDistance();
        refreshRouteMatches();
    }

    document.getElementById('PickupDateTime')?.addEventListener('change', refreshRouteMatches);
    document.getElementById('PickupDateTime')?.addEventListener('input', refreshRouteMatches);

    document.getElementById('override-distance')?.addEventListener('click', function(e) {
        e.preventDefault();
        document.getElementById('DistanceKm').value = '';
        document.getElementById('DistanceAutoCalculated').value = 'false';
        document.getElementById('distance-auto-badge').classList.add('d-none');
        document.getElementById('distance-hint').classList.remove('d-none');
        document.getElementById('DistanceKm').focus();
    });

    // init both location fields
    makeAutocomplete('FromLocation', 'FromPlaceId', 'FromLatitude', 'FromLongitude', onLocationSelected);
    makeAutocomplete('ToLocation',   'ToPlaceId',   'ToLatitude',   'ToLongitude',   onLocationSelected);
})();
</script>

<script>
(function () {
    const commissionRate = @Model.CommissionPercent / 100;

    // ── "Other" cargo type ───────────────────────────────────────────────────
    const pkgSelect   = document.getElementById('PackageTypeSelect');
    const otherWrap   = document.getElementById('otherTypeWrap');
    const otherInput  = document.getElementById('OtherPackageType');
    const pkgHidden   = document.getElementById('PackageType'); // the actual bound input

    pkgSelect.addEventListener('change', function () {
        const isOther = this.value === 'Other';
        otherWrap.classList.toggle('d-none', !isOther);
        if (isOther) {
            otherInput.focus();
        }
        updateSummary();
    });

    otherInput.addEventListener('input', function () {
        // write the custom value back into the bound select so model binding picks it up
        let opt = pkgSelect.querySelector('option[value="__custom__"]');
        if (!opt) {
            opt = document.createElement('option');
            opt.value = '__custom__';
            pkgSelect.appendChild(opt);
        }
        opt.value = this.value;
        opt.textContent = this.value;
        pkgSelect.value = this.value;
        updateSummary();
    });

    // ── Pricing mode toggle ──────────────────────────────────────────────────
    document.querySelectorAll('.pricing-radio').forEach(function (radio) {
        radio.addEventListener('change', function () {
            document.querySelectorAll('.pricing-mode-option').forEach(function (el) {
                el.classList.remove('selected');
            });
            this.closest('.pricing-mode-option').classList.add('selected');
            const isFixed = this.value === 'FixedTotal';
            document.getElementById('field-fixed').classList.toggle('d-none', !isFixed);
            document.getElementById('field-perkg').classList.toggle('d-none', isFixed);
            updateSummary();
        });
    });

    // ── Live summary ─────────────────────────────────────────────────────────
    function getCost() {
        const mode = document.querySelector('.pricing-radio:checked')?.value ?? 'FixedTotal';
        if (mode === 'FixedTotal') {
            return parseFloat(document.getElementById('TransportCost')?.value) || 0;
        }
        const pkg = parseFloat(document.getElementById('PricePerKg')?.value) || 0;
        const wt  = parseFloat(document.getElementById('WeightTonnes')?.value) || 0;
        return pkg * wt * 1000;
    }

    function fmt(v) {
        return v > 0
            ? 'KSh ' + v.toLocaleString('en-KE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
            : '—';
    }

    function updateSummary() {
        const cost       = getCost();
        const commission = cost * commissionRate;
        const net        = cost - commission;
        const advance    = net * 0.70;
        const balance    = net - advance;

        const from = document.getElementById('FromLocation')?.value.trim();
        const to   = document.getElementById('ToLocation')?.value.trim();
        const wt   = parseFloat(document.getElementById('WeightTonnes')?.value) || 0;
        const type = pkgSelect?.value || '';
        const displayType = type === '' ? '—' : type;

        document.getElementById('sum-type').textContent      = displayType;
        document.getElementById('sum-weight').textContent    = wt > 0 ? wt.toLocaleString('en-KE', { maximumFractionDigits: 1 }) + ' tonnes' : '—';
        document.getElementById('sum-route').textContent     = (from && to) ? from + ' → ' + to : '—';
        document.getElementById('sum-cost').textContent      = fmt(cost);
        document.getElementById('sum-commission').textContent = cost > 0 ? '–' + fmt(commission) : '—';
        document.getElementById('sum-net').textContent       = fmt(net);
        document.getElementById('sum-advance').textContent   = net > 0 ? fmt(advance) : '—';
        document.getElementById('sum-balance').textContent   = fmt(balance);

        const calcEl = document.getElementById('calcTotal');
        if (calcEl) {
            const mode = document.querySelector('.pricing-radio:checked')?.value;
            calcEl.textContent = mode === 'PerKg' && cost > 0 ? fmt(cost) : '—';
        }
    }

    // attach listeners
    ['TransportCost','PricePerKg','WeightTonnes','RetentionPeriodDays'].forEach(function (id) {
        document.getElementById(id)?.addEventListener('input', updateSummary);
    });
    const weightSlider = document.getElementById('WeightTonnes');
    const weightOutput = document.getElementById('WeightTonnesOutput');
    weightSlider?.addEventListener('input', function () {
        weightOutput.textContent = Number(this.value).toLocaleString('en-KE', { maximumFractionDigits: 1 }) + ' tonnes';
    });

    const termsCheckbox = document.getElementById('TermsAccepted');
    const submitCargoButton = document.getElementById('submitCargoButton');
    termsCheckbox?.addEventListener('change', function () {
        submitCargoButton.disabled = !this.checked;
    });

    const termsModal = document.getElementById('termsModal');
    document.getElementById('openTerms')?.addEventListener('click', function () { termsModal.hidden = false; });
    termsModal?.querySelectorAll('[data-close-terms]').forEach(function (element) {
        element.addEventListener('click', function () { termsModal.hidden = true; });
    });
    pkgSelect?.addEventListener('change', updateSummary);

    // location fields accept both dropdown selection and plain text


    updateSummary();
})();
</script>
}
