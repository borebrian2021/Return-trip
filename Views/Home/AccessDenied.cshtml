@{
    Layout = "_RegistrationLayout";
    ViewData["Title"] = "Access Denied";
}

<div class="auth-card text-center">
    <div class="auth-denied-icon mx-auto">
        <i class="fa fa-ban"></i>
    </div>

    <p class="auth-card__eyebrow">403 — Forbidden</p>
    <h1 class="auth-card__title">Access denied</h1>
    <p class="auth-card__sub">
        Your account does not have permission to access that page.
        If you think this is a mistake, please sign in with the correct account.
    </p>

    <div class="auth-action-group justify-content-center">
        <a asp-action="Index" class="auth-btn-primary" style="flex:1;max-width:200px;">
            <i class="fa fa-home me-2"></i>Go to Home
        </a>
        <a asp-action="Login" class="auth-btn-secondary">
            <i class="fa fa-sign-in-alt me-1"></i>Sign In
        </a>
    </div>
</div>
