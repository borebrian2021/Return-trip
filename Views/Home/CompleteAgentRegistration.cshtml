@model Return_trip.Models.AgentClaimViewModel
@{
    Layout = "_RegistrationLayout";
    ViewData["Title"] = "Activate agent account";
}

<div class="wpb-content-wrapper">
    <div class="vc_row wpb_row vc_row-fluid rt-registration-section">
        <div class="wpb_column vc_column_container vc_col-sm-9"><div class="vc_column-inner"><div class="wpb_wrapper">
            <div class="wpb_text_column wpb_content_element rt-registration-intro"><div class="wpb_wrapper"><p>We found the agent profile entered by your vehicle owner. Create a password to activate your Return Trip sign-in.</p></div></div>
            <div class="stm_auto_loan_calculator wide-version">
                <div class="title single-calculator-title"><i class="stm-icon-calculator"></i><h3>Activate Agent Sign-in</h3></div>
                <form asp-action="CompleteAgentRegistration" method="post" class="rt-registration-form">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                    <div class="row">
                        <div class="col-md-12"><div class="form-group"><div class="labeled heading-font">Verified agent profile</div><input class="form-control" value="@Model.ProfileName" readonly /></div></div>
                        <div class="col-md-12"><div class="form-group"><div class="labeled heading-font"><label asp-for="Email"></label></div><input asp-for="Email" class="form-control" type="email" readonly autocomplete="email" /><span asp-validation-for="Email"></span></div></div>
                        <div class="col-md-6"><div class="form-group"><div class="labeled heading-font"><label asp-for="Password"></label></div><input asp-for="Password" class="form-control" type="password" autocomplete="new-password" /><span asp-validation-for="Password"></span></div></div>
                        <div class="col-md-6"><div class="form-group"><div class="labeled heading-font"><label asp-for="ConfirmPassword"></label></div><input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></div></div>
                        <div class="col-md-12"><button type="submit" class="button button-sm">Create agent sign-in</button></div>
                    </div>
                </form>
            </div>
        </div></div></div>
        <div class="wpb_column vc_column_container vc_col-sm-3"><div class="vc_column-inner"><div class="wpb_wrapper rt-registration-sidebar">
            <div class="widget widget_pages"><div class="widget-title"><h6>Identity-managed account</h6></div><p>Your account uses the email entered by your vehicle owner. ASP.NET Core Identity handles password hashing, sign-in cookies and the company-agent role.</p></div>
        </div></div></div>
    </div>
</div>
