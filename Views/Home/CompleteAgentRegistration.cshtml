@model Return_trip.Models.AgentClaimViewModel
@{
    Layout = "_RegistrationLayout";
    ViewData["Title"] = "Activate Agent Account";
}

<div class="auth-card">
    <p class="auth-card__eyebrow"><i class="fa fa-check-circle me-1"></i>Profile Found</p>
    <h1 class="auth-card__title">Activate your sign-in</h1>
    <p class="auth-card__sub">
        We found your agent profile. Create a password below to activate your Return Trip account.
    </p>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="auth-alert">
            <div asp-validation-summary="ModelOnly"></div>
        </div>
    }

    <form asp-action="CompleteAgentRegistration" method="post">
        @Html.AntiForgeryToken()

        <div class="auth-section-label">Verified profile</div>

        <div class="row g-3">
            <div class="col-12">
                <div class="auth-field">
                    <label>Agent Name</label>
                    <input class="form-control" value="@Model.ProfileName" readonly />
                </div>
            </div>
            <div class="col-12">
                <div class="auth-field">
                    <label asp-for="Email">Email Address</label>
                    <input asp-for="Email" class="form-control" type="email" readonly autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="auth-section-label">Set your password</div>

        <div class="row g-3">
            <div class="col-6">
                <div class="auth-field">
                    <label asp-for="Password">Password</label>
                    <input asp-for="Password" class="form-control" type="password" autocomplete="new-password" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                    <small>Min 8 chars · uppercase · number</small>
                </div>
            </div>
            <div class="col-6">
                <div class="auth-field">
                    <label asp-for="ConfirmPassword">Confirm Password</label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
            </div>
        </div>

        <button type="submit" class="auth-btn-primary mt-4">
            <i class="fa fa-unlock-alt me-2"></i>Create Agent Sign-In
        </button>
    </form>
</div>

<div class="auth-info-banner mt-3">
    <strong><i class="fa fa-shield-alt me-1"></i>Identity-managed account</strong>
    Your account uses the email entered by your vehicle owner. ASP.NET Core Identity handles
    password hashing, sign-in cookies, and role assignment.
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
