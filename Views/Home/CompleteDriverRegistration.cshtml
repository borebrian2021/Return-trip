@model Return_trip.Models.DriverClaimViewModel
@{
    Layout = "_RegistrationLayout";
    ViewData["Title"] = "Activate Driver Account";
}

<div class="auth-card">
    <p class="auth-card__eyebrow"><i class="fa fa-check-circle me-1"></i>Profile Found</p>
    <h1 class="auth-card__title">Activate your sign-in</h1>
    <p class="auth-card__sub">
        We found your driver profile. Confirm the email registered by your vehicle owner
        and create a password to complete your account setup.
    </p>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="auth-alert">
            <div asp-validation-summary="ModelOnly"></div>
        </div>
    }

    <form asp-action="CompleteDriverRegistration" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="IdNumber" type="hidden" />
        <input asp-for="ProfileName" type="hidden" />

        <div class="auth-section-label">Verified profile</div>

        <div class="auth-field">
            <label>Driver Name</label>
            <input class="form-control" value="@Model.ProfileName" readonly />
        </div>

        <div class="auth-field">
            <label asp-for="Email">Confirm Registered Email</label>
            <input asp-for="Email" class="form-control" type="email" autocomplete="email"
                   placeholder="Must match what your vehicle owner entered" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="auth-section-label">Set your password</div>

        <div class="row g-3">
            <div class="col-6">
                <div class="auth-field">
                    <label asp-for="Password">Password</label>
                    <input asp-for="Password" class="form-control" type="password" autocomplete="new-password" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                    <small>Min 8 chars · uppercase · number</small>
                </div>
            </div>
            <div class="col-6">
                <div class="auth-field">
                    <label asp-for="ConfirmPassword">Confirm Password</label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
            </div>
        </div>

        <button type="submit" class="auth-btn-primary mt-4">
            <i class="fa fa-unlock-alt me-2"></i>Create Driver Sign-In
        </button>
    </form>
</div>

<div class="auth-info-banner mt-3">
    <strong><i class="fa fa-shield-alt me-1"></i>Security note</strong>
    The email must exactly match the address your vehicle owner entered. Your password
    is handled by ASP.NET Core Identity — never stored as plain text.
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
