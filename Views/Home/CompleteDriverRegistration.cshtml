@model Return_trip.Models.DriverClaimViewModel
@{
    Layout = "_RegistrationLayout";
    ViewData["Title"] = "Activate driver account";
}

<div class="wpb-content-wrapper">
    <div class="vc_row wpb_row vc_row-fluid rt-registration-section">
        <div class="wpb_column vc_column_container vc_col-sm-9"><div class="vc_column-inner"><div class="wpb_wrapper">
            <div class="wpb_text_column wpb_content_element rt-registration-intro"><div class="wpb_wrapper">
                <p>We found the driver profile entered by your vehicle owner. Confirm the registered email and create a password to activate your system sign-in.</p>
            </div></div>
            <div class="stm_auto_loan_calculator wide-version">
                <div class="title single-calculator-title"><i class="stm-icon-calculator"></i><h3>Activate Driver Sign-in</h3></div>
                <form asp-action="CompleteDriverRegistration" method="post" class="rt-registration-form">
                    @Html.AntiForgeryToken()
                    <input asp-for="IdNumber" type="hidden" />
                    <input asp-for="ProfileName" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                    <div class="row">
                        <div class="col-md-12"><div class="form-group"><div class="labeled heading-font">Verified driver profile</div><input class="form-control" value="@Model.ProfileName" readonly /></div></div>
                        <div class="col-md-12"><div class="form-group"><div class="labeled heading-font"><label asp-for="Email"></label></div><input asp-for="Email" class="form-control" type="email" autocomplete="email" /><span asp-validation-for="Email"></span></div></div>
                        <div class="col-md-6"><div class="form-group"><div class="labeled heading-font"><label asp-for="Password"></label></div><input asp-for="Password" class="form-control" type="password" autocomplete="new-password" /><span asp-validation-for="Password"></span></div></div>
                        <div class="col-md-6"><div class="form-group"><div class="labeled heading-font"><label asp-for="ConfirmPassword"></label></div><input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></div></div>
                        <div class="col-md-12"><button type="submit" class="button button-sm">Create driver sign-in</button></div>
                    </div>
                </form>
            </div>
        </div></div></div>
        <div class="wpb_column vc_column_container vc_col-sm-3"><div class="vc_column-inner"><div class="wpb_wrapper rt-registration-sidebar">
            <div class="widget widget_pages"><div class="widget-title"><h6>Security check</h6></div><p>The email must match the address your vehicle owner entered. Your password is stored and verified by ASP.NET Core Identity, not as plain text.</p></div>
        </div></div></div>
    </div>
</div>
