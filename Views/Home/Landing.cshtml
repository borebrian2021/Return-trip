    <!-- ── Live Freight Board ─────────────────────────────────────────────── -->
    <div class="product-section" id="freight-board">
        <div class="container">

            <div class="row align-items-end mb-5">
                <div class="col-lg-5">
                    <h2 class="section-title mb-2">Latest Open Freight Listings</h2>
                    <p class="mb-0">
                        The latest cargo posted by goods owners across Kenya.
                        Drivers and agents can bid on any open load heading their route.
                    </p>
                </div>
                <div class="col-lg-7 text-lg-end mt-3 mt-lg-0">
                    <div class="freight-filter-tabs">
                        <button class="freight-tab active" data-filter="all">All</button>
                        <button class="freight-tab" data-filter="bulk">Bulk</button>
                        <button class="freight-tab" data-filter="palletised">Palletised</button>
                        <button class="freight-tab" data-filter="refrigerated">Refrigerated</button>
                        <button class="freight-tab" data-filter="machinery">Machinery</button>
                        <button class="freight-tab" data-filter="other">Other</button>
                    </div>
                </div>
            </div>

            <div class="row" id="freight-cards">
                @if (Model.Count == 0)
                {
                    <div class="col-12 text-center py-5">
                        <i class="fa fa-box-open mb-3" style="font-size:36px;color:#9a9a9a;" aria-hidden="true"></i>
                        <h3>No open cargo listings yet</h3>
                        <p>New listings from goods owners will appear here.</p>
                        <a href="/Home/RegisterGoodsOwner" class="btn btn-primary">Post Cargo</a>
                    </div>
                }
                else
                {
                    @foreach (var cargo in Model)
                    {
                        var category = GetCargoCategory(cargo.PackageType);
                        var icon = GetCargoIcon(category);
                        <div class="col-12 col-md-6 col-lg-3 mb-5" data-type="@category">
                            <div class="product-item freight-card">
                                <span class="freight-badge freight-badge--open">Open</span>
                                <div class="freight-placeholder" aria-hidden="true">
                                    <i class="fa @icon"></i>
                                </div>
                                <div class="freight-body">
                                    <div class="freight-type-row">
                                        <span class="freight-type-pill"><i class="fa @icon me-1"></i>@cargo.PackageType</span>
                                        <span class="freight-weight"><i class="fa fa-weight-hanging me-1"></i>@cargo.WeightKg.ToString("N0") kg</span>
                                    </div>
                                    <h3 class="freight-route">@cargo.Route</h3>
                                    <p class="freight-cargo-name">@cargo.Title</p>
                                    <div class="freight-details-grid">
                                        <div class="freight-detail-item">
                                            <span class="detail-label">Departs</span>
                                            <span class="detail-value">@(cargo.RequiredDepartureAt?.ToString("dd MMM yyyy") ?? "Flexible")</span>
                                        </div>
                                        <div class="freight-detail-item">
                                            <span class="detail-label">Bids</span>
                                            <span class="detail-value">@cargo.BidCount bid@(cargo.BidCount == 1 ? "" : "s") received</span>
                                        </div>
                                        <div class="freight-detail-item">
                                            <span class="detail-label">Guide Price</span>
                                            <span class="detail-value freight-price">KSh @cargo.TransportCost.ToString("N0")</span>
                                        </div>
                                        <div class="freight-detail-item">
                                            <span class="detail-label">Deliver by</span>
                                            <span class="detail-value">@(cargo.DeliveryDeadlineAt?.ToString("dd MMM yyyy") ?? "Not specified")</span>
                                        </div>
                                    </div>
                                    <a href="/Home/Register" class="btn btn-primary freight-bid-btn">
                                        <i class="fa fa-gavel me-2"></i>Place Bid
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="row">
                <div class="col-12 text-center mt-2">
                    <a href="/Home/Register" class="btn">Register to Place a Bid</a>
                </div>
