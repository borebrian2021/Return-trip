    <script>
        document.querySelectorAll('.freight-tab').forEach(function (tab) {
            tab.addEventListener('click', function () {
                document.querySelectorAll('.freight-tab').forEach(function (t) { t.classList.remove('active'); });
                this.classList.add('active');
                var filter = this.getAttribute('data-filter');
                document.querySelectorAll('#freight-cards [data-type]').forEach(function (card) {
                    if (filter === 'all' || card.getAttribute('data-type') === filter) {
                        card.classList.remove('freight-card-hidden');
                    } else {
                        card.classList.add('freight-card-hidden');
                    }
                });
            });
        });
    </script>

</body>
</html>
