                <div class="col-lg-7 text-lg-end mt-3 mt-lg-0">
                    <div class="freight-filter-tabs">
                        <button class="freight-tab active" data-filter="all">All</button>
                        <button class="freight-tab" data-filter="bulk">Bulk</button>
                        <button class="freight-tab" data-filter="palletised">Palletised</button>
                        <button class="freight-tab" data-filter="refrigerated">Refrigerated</button>
                        <button class="freight-tab" data-filter="machinery">Machinery</button>
                    </div>
                </div>
            </div>

            <!-- freight cards -->
            <div class="row" id="freight-cards">

                <!-- Card 1 – Bulk -->
                <div class="col-12 col-md-6 col-lg-3 mb-5" data-type="bulk">
                    <div class="product-item freight-card">
                        <span class="freight-badge freight-badge--open">Open</span>
                        <img src="~/images/vehicles/balast.jpg" class="img-fluid product-thumbnail" alt="Crushed Stone">
                        <div class="freight-body">
                            <div class="freight-type-row">
                                <span class="freight-type-pill"><i class="fa fa-box-open me-1"></i>Bulk</span>
                                <span class="freight-weight"><i class="fa fa-weight-hanging me-1"></i>14 000 kg</span>
                            </div>
                            <h3 class="freight-route">Johannesburg <span class="route-arrow">&#8594;</span> Cape Town</h3>
                            <p class="freight-cargo-name">Crushed Stone</p>
                            <div class="freight-details-grid">
                                <div class="freight-detail-item">
                                    <span class="detail-label">Departs</span>
                                    <span class="detail-value">22 Oct 2026</span>
                                </div>
                                <div class="freight-detail-item">
                                    <span class="detail-label">Bids</span>
                                    <span class="detail-value">3 received</span>
                                </div>
                                <div class="freight-detail-item">
                                    <span class="detail-label">Guide Price</span>
                                    <span class="detail-value freight-price">R 8 500</span>
                                </div>
                                <div class="freight-detail-item">
                                    <span class="detail-label">Package</span>
                                    <span class="detail-value">Loose load</span>
                                </div>
                            </div>
                            <a href="/Home/Register" class="btn btn-primary freight-bid-btn">
                                <i class="fa fa-gavel me-2"></i>Place Bid
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Card 2 – Palletised -->
