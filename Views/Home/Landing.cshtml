@model IReadOnlyList<CargoListingRow>
@{
    Layout = null;
}
@functions {
    private static string GetCargoCategory(string packageType)
    {
        if (packageType.Contains("bulk", StringComparison.OrdinalIgnoreCase) ||
            packageType.Contains("loose", StringComparison.OrdinalIgnoreCase))
            return "bulk";
        if (packageType.Contains("pallet", StringComparison.OrdinalIgnoreCase))
            return "palletised";
        if (packageType.Contains("refrigerat", StringComparison.OrdinalIgnoreCase))
            return "refrigerated";
        if (packageType.Contains("machin", StringComparison.OrdinalIgnoreCase) ||
            packageType.Contains("plant", StringComparison.OrdinalIgnoreCase))
            return "machinery";
        return "other";
    }

    private static string GetCargoIcon(string category) => category switch
    {
        "bulk" => "fa-box-open",
        "palletised" => "fa-pallet",
        "refrigerated" => "fa-snowflake",
        "machinery" => "fa-cogs",
        _ => "fa-box",
    };
}
