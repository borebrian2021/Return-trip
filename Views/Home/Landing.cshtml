    <!-- ── How It Works ───────────────────────────────────────────────────── -->
    <div class="we-help-section" id="how-it-works">
        <div class="container">
            <div class="row justify-content-between">
                <div class="col-lg-7 mb-5 mb-lg-0">
                    <div class="imgs-grid">
                        {{!-- Operations photos --}}
                        <div class="grid grid-1"><img src="~/images/vehicles/cargo3.jpg" alt="Loading cargo"></div>
                        <div class="grid grid-2"><img src="~/images/vehicles/cargo4.jpg" alt="Truck on the road"></div>
                        <div class="grid grid-3"><img src="~/images/vehicles/cargo5.jpg" alt="Delivery confirmation"></div>
                    </div>
                </div>
                <div class="col-lg-5 ps-lg-5">
                    <h2 class="section-title mb-4">How Return Trip Works</h2>
                    <p>
                        Our platform connects goods owners with truck operators in three simple steps.
                        No phone calls, no haggling — just transparent bids and confirmed bookings.
                    </p>
                    <ul class="list-unstyled custom-list my-4">
                        <li>Goods owner posts a cargo listing with pickup &amp; delivery details</li>
                        <li>Agents bid on behalf of available vehicles heading that route</li>
                        <li>Goods owner reviews bids and accepts the best offer</li>
                        <li>Driver collects, delivers, and uploads a signed receipt</li>
                    </ul>
                    <p><a href="/Home/Register" class="btn">Get Started</a></p>
                </div>
            </div>
        </div>
    </div>
    <!-- ── End How It Works ───────────────────────────────────────────────── -->

