@{
    Layout = "_RegistrationLayout";
    ViewData["Title"] = "Create an Account";
}

<div class="auth-card">
    <p class="auth-card__eyebrow"><i class="fa fa-user-plus me-1"></i>Get Started</p>
    <h1 class="auth-card__title">Choose your role</h1>
    <p class="auth-card__sub">
        Select the account type that matches your place in the freight journey.
        All roles are free to register.
    </p>

    <div class="role-cards">

        <a class="role-card" asp-action="RegisterGoodsOwner">
            <div class="role-card__icon"><i class="fa fa-box-open"></i></div>
            <div class="role-card__body">
                <div class="role-card__title">Goods Owner</div>
                <p class="role-card__desc">Post cargo requests and connect your freight with return-trip vehicles.</p>
            </div>
            <i class="fa fa-chevron-right role-card__arrow"></i>
        </a>

        <a class="role-card" asp-action="RegisterVehicleOwner">
            <div class="role-card__icon"><i class="fa fa-truck"></i></div>
            <div class="role-card__body">
                <div class="role-card__title">Vehicle Owner</div>
                <p class="role-card__desc">Register your fleet, manage drivers and agents, and earn on return trips.</p>
            </div>
            <i class="fa fa-chevron-right role-card__arrow"></i>
        </a>

        <a class="role-card" asp-action="RegisterDriver">
            <div class="role-card__icon"><i class="fa fa-id-card"></i></div>
            <div class="role-card__body">
                <div class="role-card__title">Driver</div>
                <p class="role-card__desc">Claim the profile your vehicle owner created for you using your national ID.</p>
            </div>
            <i class="fa fa-chevron-right role-card__arrow"></i>
        </a>

        <a class="role-card" asp-action="RegisterAgent">
            <div class="role-card__icon"><i class="fa fa-user-tie"></i></div>
            <div class="role-card__body">
                <div class="role-card__title">Company Agent</div>
                <p class="role-card__desc">Claim the agent profile entered by your vehicle owner using your registered email.</p>
            </div>
            <i class="fa fa-chevron-right role-card__arrow"></i>
        </a>

    </div>

    <hr>

    <p class="text-center mb-0" style="font-size:14px;color:#9a9a9a;">
        Already have an account?
        <a asp-action="Login" style="color:#1a3c5e;font-weight:600;text-decoration:none;">Sign in</a>
    </p>
</div>
