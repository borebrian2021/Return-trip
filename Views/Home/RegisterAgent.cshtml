@model Return_trip.Models.AgentEmailLookupViewModel
@{
    Layout = "_RegistrationLayout";
    ViewData["Title"] = "Claim Agent Profile";
}

<div class="auth-card">
    <p class="auth-card__eyebrow"><i class="fa fa-user-tie me-1"></i>Company Agent</p>
    <h1 class="auth-card__title">Find your profile</h1>
    <p class="auth-card__sub">
        Your vehicle owner must register your agent details before you can sign in.
        Enter the email address recorded on your agent profile.
    </p>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="auth-alert">
            <div asp-validation-summary="ModelOnly"></div>
        </div>
    }

    <form asp-action="RegisterAgent" method="post">
        @Html.AntiForgeryToken()

        <div class="auth-field">
            <label asp-for="Email">Registered Email Address</label>
            <input asp-for="Email" class="form-control" type="email" autocomplete="email"
                   placeholder="agent@yourcompany.co.za" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <button type="submit" class="auth-btn-primary mt-2">
            <i class="fa fa-search me-2"></i>Find My Agent Profile
        </button>
    </form>

    <hr>
    <p class="text-center mb-0" style="font-size:14px;color:#9a9a9a;">
        Not an agent?
        <a asp-action="Register" style="color:#1a3c5e;font-weight:600;text-decoration:none;">Choose a different role</a>
    </p>
</div>

<div class="auth-info-banner mt-3">
    <strong><i class="fa fa-info-circle me-1"></i>How agent onboarding works</strong>
    Your fleet owner enters your name, email, and phone number. The system verifies the
    existing record, then lets you set your own password to activate the account.
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
