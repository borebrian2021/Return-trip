@model Return_trip.Models.DriverIdLookupViewModel
@{
    Layout = "_RegistrationLayout";
    ViewData["Title"] = "Claim Driver Profile";
}

<div class="auth-card">
    <p class="auth-card__eyebrow"><i class="fa fa-id-card me-1"></i>Driver</p>
    <h1 class="auth-card__title">Find your profile</h1>
    <p class="auth-card__sub">
        Your vehicle owner must register your details first. Enter your national ID number
        to locate your driver profile and activate your sign-in.
    </p>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="auth-alert">
            <div asp-validation-summary="ModelOnly"></div>
        </div>
    }

    <form asp-action="RegisterDriver" method="post">
        @Html.AntiForgeryToken()

        <div class="auth-field">
            <label asp-for="IdNumber">National ID Number</label>
            <input asp-for="IdNumber" class="form-control" autocomplete="off"
                   placeholder="Enter your 13-digit ID number" style="letter-spacing:.5px;" />
            <span asp-validation-for="IdNumber" class="text-danger"></span>
        </div>

        <button type="submit" class="auth-btn-primary mt-2">
            <i class="fa fa-search me-2"></i>Find My Driver Profile
        </button>
    </form>

    <hr>
    <p class="text-center mb-0" style="font-size:14px;color:#9a9a9a;">
        Not a driver?
        <a asp-action="Register" style="color:#1a3c5e;font-weight:600;text-decoration:none;">Choose a different role</a>
    </p>
</div>

<div class="auth-info-banner mt-3">
    <strong><i class="fa fa-info-circle me-1"></i>How driver onboarding works</strong>
    Your vehicle owner enters your name, ID number, licence details, phone, and email.
    The system matches your ID to that record, then asks you to confirm the email and set a password.
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
