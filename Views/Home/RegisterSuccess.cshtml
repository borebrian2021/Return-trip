@model Return_trip.Models.RegistrationSuccessViewModel
@{
    Layout = "_RegistrationLayout";
    ViewData["Title"] = "Registration Complete";
    bool isReady   = Model.RoleLabel == "Goods owner";
    bool isVehicle = Model.RoleLabel == "Vehicle owner";
}

<div class="auth-card text-center">
    <div class="auth-success-icon mx-auto">
        <i class="fa @(isReady ? "fa-check" : "fa-paper-plane")"></i>
    </div>

    <p class="auth-card__eyebrow">
        @(isReady ? "You're all set" : "Submitted")
    </p>
    <h1 class="auth-card__title">
        @(isReady ? "Account ready!" : $"{Model.RoleLabel} registration received")
    </h1>
    <p class="auth-card__sub">@Model.Message</p>

    <div class="auth-action-group justify-content-center">
        <a asp-action="Index" class="auth-btn-primary" style="flex:1;max-width:220px;">
            <i class="fa fa-home me-2"></i>Go to Home
        </a>
        @if (isVehicle)
        {
            <a asp-action="AddDriver" class="auth-btn-secondary">
                <i class="fa fa-id-card me-1"></i>Add Driver
            </a>
            <a asp-action="AddAgent" class="auth-btn-secondary">
                <i class="fa fa-user-tie me-1"></i>Add Agent
            </a>
        }
        <a asp-action="Register" class="auth-btn-secondary">
            <i class="fa fa-plus me-1"></i>Register Another
        </a>
    </div>
</div>

@if (isVehicle)
{
    <div class="auth-info-banner mt-3">
        <strong><i class="fa fa-lightbulb me-1"></i>Next steps for vehicle owners</strong>
        Now that your account is created, register your drivers and company agents so they
        can claim their own profiles and start bidding on cargo listings.
    </div>
}
