@model Return_trip.Models.VehicleOwnerRegistrationViewModel
@{
    Layout = "_RegistrationLayout";
    ViewData["Title"] = "Vehicle Owner Registration";
}

<div class="auth-card">
<div style="margin:30px;padding-top:30px; padding-bottom:30px">
    <p class="auth-card__eyebrow" style="margin-top:15px"><i class="fa fa-truck me-1"></i>Vehicle Owner</p>
    <h1 class="auth-card__title">Register your fleet</h1>
    <p class="auth-card__sub">Manage your transport business, onboard drivers and agents, and earn revenue on every return trip.</p>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="auth-alert">
            <div asp-validation-summary="ModelOnly"></div>
        </div>
    }

    <form asp-action="RegisterVehicleOwner" method="post">
        @Html.AntiForgeryToken()

        <div class="auth-section-label">Contact person</div>

        <div class="row g-3">
            <div class="col-6">
                <div class="auth-field">
                    <label asp-for="FirstName">First Name</label>
                    <input asp-for="FirstName" class="form-control" autocomplete="given-name" placeholder="John" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
            </div>
            <div class="col-6">
                <div class="auth-field">
                    <label asp-for="LastName">Last Name</label>
                    <input asp-for="LastName" class="form-control" autocomplete="family-name" placeholder="Kamau" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
            </div>
            <div class="col-6">
                <div class="auth-field">
                    <label asp-for="Email">Email</label>
                    <input asp-for="Email" class="form-control" type="email" autocomplete="email" placeholder="you@example.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>
            <div class="col-6">
                <div class="auth-field">
                    <label asp-for="Phone">Phone</label>
                    <input asp-for="Phone" class="form-control" type="tel" autocomplete="tel" placeholder="+254 7xx xxx xxx" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="auth-section-label">Company details</div>

        <div class="row g-3">
            <div class="col-12">
                <div class="auth-field">
                    <label asp-for="CompanyName">Company / Trading Name</label>
                    <input asp-for="CompanyName" class="form-control" autocomplete="organization" placeholder="Swift Haulage Ltd" />
                    <span asp-validation-for="CompanyName" class="text-danger"></span>
                </div>
            </div>
            <div class="col-6">
                <div class="auth-field">
                    <label asp-for="BusinessRegistrationNumber">Business Reg. Number</label>
                    <input asp-for="BusinessRegistrationNumber" class="form-control" placeholder="e.g. CPR/2024/000000" />
                    <span asp-validation-for="BusinessRegistrationNumber" class="text-danger"></span>
                </div>
            </div>
            <div class="col-6">
                <div class="auth-field">
                    <label asp-for="Location">Primary Location</label>
                    <input asp-for="Location" class="form-control" autocomplete="address-level2" placeholder="Nairobi, Kenya" />
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="auth-section-label">Set your password</div>

        <div class="row g-3">
            <div class="col-6">
                <div class="auth-field">
                    <label asp-for="Password">Password</label>
                    <input asp-for="Password" class="form-control" type="password" autocomplete="new-password" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                    <small>Min 8 chars · uppercase · number</small>
                </div>
            </div>
            <div class="col-6">
                <div class="auth-field">
                    <label asp-for="ConfirmPassword">Confirm Password</label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="d-flex gap-3 mt-4">
            <a asp-action="Register" class="auth-btn-secondary">
                <i class="fa fa-arrow-left"></i> Back
            </a>
            <button type="submit" class="auth-btn-primary" style="flex:1;">
                <i class="fa fa-check me-2"></i>Create Vehicle Owner Account
            </button>
        </div>
    </form>
</div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
