<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>@ViewData["Title"] – Return Trip</title>
    <link rel="shortcut icon" href="~/favicon.png">
    <link href="~/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="dash-body">

<div class="dash-shell">

    <!-- ── Sidebar ────────────────────────────────────────────────────────── -->
    <aside class="dash-sidebar">
        <div class="dash-sidebar__brand">
            <a asp-controller="Home" asp-action="Index">
                Return Trip<span>.</span>
            </a>
        </div>

        <nav class="dash-sidebar__nav">
            @{ var role = ViewData["DashRole"]?.ToString() ?? "GoodsOwner"; }

            @if (role == "GoodsOwner")
            {
                <p class="dash-nav-label">Main</p>
                <ul>
                    <li class="@(ViewData["ActiveNav"]?.ToString() == "dashboard" ? "active" : "")">
                        <a asp-controller="GoodsOwner" asp-action="Dashboard">
                            <i class="fa fa-th-large"></i><span>Dashboard</span>
                        </a>
                    </li>
                </ul>
                <p class="dash-nav-label">Cargo</p>
                <ul>
                    <li class="@(ViewData["ActiveNav"]?.ToString() == "post" ? "active" : "")">
                        <a asp-controller="GoodsOwner" asp-action="PostCargo">
                            <i class="fa fa-plus-circle"></i><span>Post Cargo</span>
                        </a>
                    </li>
                    <li class="@(ViewData["ActiveNav"]?.ToString() == "listings" ? "active" : "")">
                        <a asp-controller="GoodsOwner" asp-action="MyListings">
                            <i class="fa fa-list"></i><span>My Listings</span>
                        </a>
                    </li>
                    <li class="@(ViewData["ActiveNav"]?.ToString() == "bids" ? "active" : "")">
                        <a asp-controller="GoodsOwner" asp-action="Bids">
                            <i class="fa fa-gavel"></i><span>Bids Received</span>
                        </a>
                    </li>
                    <li class="@(ViewData["ActiveNav"]?.ToString() == "transit" ? "active" : "")">
                        <a asp-controller="GoodsOwner" asp-action="InTransit">
                            <i class="fa fa-truck"></i><span>In Transit</span>
                        </a>
                    </li>
                </ul>
                <p class="dash-nav-label">Account</p>
                <ul>
                    <li class="@(ViewData["ActiveNav"]?.ToString() == "banking" ? "active" : "")">
                        <a asp-controller="GoodsOwner" asp-action="Banking">
                            <i class="fa fa-university"></i><span>Bank Details</span>
                        </a>
                    </li>
                    <li class="@(ViewData["ActiveNav"]?.ToString() == "profile" ? "active" : "")">
                        <a asp-controller="GoodsOwner" asp-action="Profile">
                            <i class="fa fa-user-circle"></i><span>Profile</span>
                        </a>
                    </li>
                </ul>
            }
            else if (role == "VehicleOwner")
            {
                <p class="dash-nav-label">Main</p>
                <ul>
                    <li class="@(ViewData["ActiveNav"]?.ToString() == "dashboard" ? "active" : "")">
                        <a asp-controller="VehicleOwner" asp-action="Dashboard">
                            <i class="fa fa-th-large"></i><span>Dashboard</span>
                        </a>
                    </li>
                </ul>
                <p class="dash-nav-label">Fleet</p>
                <ul>
                    <li class="@(ViewData["ActiveNav"]?.ToString() == "drivers" ? "active" : "")">
                        <a asp-controller="VehicleOwner" asp-action="Drivers">
                            <i class="fa fa-id-card"></i><span>Drivers</span>
                        </a>
                    </li>
                    <li class="@(ViewData["ActiveNav"]?.ToString() == "agents" ? "active" : "")">
                        <a asp-controller="VehicleOwner" asp-action="Agents">
                            <i class="fa fa-user-tie"></i><span>Agents</span>
                        </a>
                    </li>
                    <li class="@(ViewData["ActiveNav"]?.ToString() == "companies" ? "active" : "")">
                        <a asp-controller="VehicleOwner" asp-action="Companies">
                            <i class="fa fa-building"></i><span>Companies</span>
                        </a>
                    </li>
                    <li class="@(ViewData["ActiveNav"]?.ToString() == "vehicles" ? "active" : "")">
                        <a asp-controller="VehicleOwner" asp-action="Vehicles">
                            <i class="fa fa-truck"></i><span>Vehicles</span>
                        </a>
                    </li>
                    <li class="@(ViewData["ActiveNav"]?.ToString() == "fleet" ? "active" : "")">
                        <a asp-controller="VehicleOwner" asp-action="Fleet">
                            <i class="fa fa-route"></i><span>Fleet Routes</span>
                        </a>
                    </li>
                </ul>
                <p class="dash-nav-label">Business</p>
                <ul>
                    <li class="@(ViewData["ActiveNav"]?.ToString() == "earnings" ? "active" : "")">
                        <a asp-controller="VehicleOwner" asp-action="Earnings">
                            <i class="fa fa-coins"></i><span>Earnings</span>
                        </a>
                    </li>
                    <li class="@(ViewData["ActiveNav"]?.ToString() == "profile" ? "active" : "")">
                        <a asp-controller="VehicleOwner" asp-action="Profile">
                            <i class="fa fa-user-circle"></i><span>Profile</span>
                        </a>
                    </li>
                </ul>
            }
            else if (role == "CompanyAgent")
            {
                <p class="dash-nav-label">Fleet</p>
                <ul>
                    <li class="@(ViewData["ActiveNav"]?.ToString() == "routes" ? "active" : "")">
                        <a asp-controller="Agent" asp-action="Routes">
                            <i class="fa fa-route"></i><span>Vehicle Routes</span>
                        </a>
                    </li>
                </ul>
            }
        </nav>

        <div class="dash-sidebar__signout">
            <form asp-controller="Home" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit">
                    <i class="fa fa-sign-out-alt"></i><span>Sign Out</span>
                </button>
            </form>
        </div>
    </aside>
    <!-- ── End Sidebar ────────────────────────────────────────────────────── -->

    <!-- ── Main area ──────────────────────────────────────────────────────── -->
    <div class="dash-main">

        <!-- topbar -->
        <header class="dash-topbar">
            <div class="dash-topbar__left">
                <button class="dash-sidebar-toggle d-lg-none" id="sidebarToggle">
                    <i class="fa fa-bars"></i>
                </button>
                <div class="dash-topbar__page-title">@ViewData["Title"]</div>
            </div>
            <div class="dash-topbar__right">
                <div class="dash-topbar__user">
                    <div class="dash-topbar__avatar">
                        @{ var initials = (ViewData["UserInitials"] as string) ?? "?"; }
                        @initials
                    </div>
                    <div class="dash-topbar__user-info">
                        <span class="dash-topbar__user-name">@ViewData["UserFullName"]</span>
                        <span class="dash-topbar__user-role">@(ViewData["DashRoleLabel"] ?? (ViewData["DashRole"]?.ToString() == "GoodsOwner" ? "Goods Owner" : "Vehicle Owner"))</span>
                    </div>
                </div>
            </div>
        </header>

        <!-- page content -->
        <main class="dash-content">
            @RenderBody()
        </main>

    </div>
    <!-- ── End Main area ──────────────────────────────────────────────────── -->

</div>

<script src="~/js/bootstrap.bundle.min.js"></script>
<script>
    // mobile sidebar toggle
    document.getElementById('sidebarToggle')?.addEventListener('click', function () {
        document.querySelector('.dash-sidebar').classList.toggle('dash-sidebar--open');
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
