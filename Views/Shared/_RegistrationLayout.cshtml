<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>@ViewData["Title"] – Return Trip</title>
    <link rel="shortcut icon" href="~/favicon.png">
    <link href="~/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="auth-page">

    <!-- minimal nav -->
    <nav class="custom-navbar navbar navbar-expand-md navbar-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                Return Trip<span>.</span>
            </a>
            <div class="ms-auto d-flex align-items-center gap-3">
                <a asp-controller="Home" asp-action="Login"
                   class="nav-link text-white" style="opacity:.7;font-size:14px;">
                    <i class="fa fa-sign-in-alt me-1"></i>Sign In
                </a>
                <a asp-controller="Home" asp-action="Register"
                   class="btn btn-secondary" style="padding:8px 22px;font-size:13px;">
                    Register
                </a>
            </div>
        </div>
    </nav>

    <!-- auth shell: centred form -->
    <div class="auth-shell">
        <div class="auth-panel-right auth-panel-center">
            <div class="auth-form-wrap">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
