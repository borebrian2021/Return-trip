@model Return_trip.Models.DriverProfileViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Add Driver";
}

<div class="dash-page-header">
    <div>
        <h1><i class="fa fa-id-card me-2" style="color:#1a3c5e;font-size:20px;"></i>Add Driver</h1>
        <p class="dash-page-header__sub">
            Enter the driver's official details. They will claim this profile using their ID number.
        </p>
    </div>
    <div class="dash-page-header__actions">
        <a asp-action="Drivers" class="dash-btn dash-btn--outline">
            <i class="fa fa-arrow-left"></i> Back to Drivers
        </a>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="dash-alert dash-alert--error mb-4">
        <i class="fa fa-exclamation-circle me-2"></i>
        <div asp-validation-summary="All"></div>
    </div>
}

<div class="row g-4">
    <div class="col-lg-7">
        <div class="dash-panel">
            <div class="dash-panel__header">
                <h2 class="dash-panel__title">
                    <i class="fa fa-user me-2" style="color:#1a3c5e;"></i>Driver Details
                </h2>
            </div>
            <div class="post-cargo-body">
                <form asp-controller="VehicleOwner" asp-action="AddDriver" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="post-field">
                                <label asp-for="FullName">Full Name</label>
                                <input asp-for="FullName" class="form-control" autocomplete="name"
                                       placeholder="e.g. John Kamau" />
                                <span asp-validation-for="FullName" class="post-field-error"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="post-field">
                                <label asp-for="IdNumber">National ID Number</label>
                                <input asp-for="IdNumber" class="form-control" autocomplete="off"
                                       placeholder="13-digit national ID" style="letter-spacing:.5px;" />
                                <span asp-validation-for="IdNumber" class="post-field-error"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="post-field">
                                <label asp-for="Email">Email Address</label>
                                <input asp-for="Email" class="form-control" type="email" autocomplete="email"
                                       placeholder="driver@example.com" />
                                <span asp-validation-for="Email" class="post-field-error"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="post-field">
                                <label asp-for="PhoneNumber">Phone Number</label>
                                <input asp-for="PhoneNumber" class="form-control" type="tel" autocomplete="tel"
                                       placeholder="+254 7xx xxx xxx" />
                                <span asp-validation-for="PhoneNumber" class="post-field-error"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="post-field">
                                <label asp-for="LicenseNumber">Driver Licence Number</label>
                                <input asp-for="LicenseNumber" class="form-control"
                                       placeholder="e.g. DL/123456/2020" />
                                <span asp-validation-for="LicenseNumber" class="post-field-error"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="post-field">
                                <label asp-for="VehicleDetailId">Assigned Vehicle</label>
                                <select asp-for="VehicleDetailId" asp-items="ViewBag.Vehicles" class="form-control">
                                    <option value="">Select a registered vehicle</option>
                                </select>
                                <span asp-validation-for="VehicleDetailId" class="post-field-error"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-3 mt-4">
                        <a asp-action="Drivers" class="dash-btn dash-btn--outline">Cancel</a>
                        <button type="submit" class="dash-btn dash-btn--primary" style="flex:1;justify-content:center;">
                            <i class="fa fa-save me-2"></i>Save Driver Profile
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="dash-panel">
            <div class="dash-panel__header">
                <h2 class="dash-panel__title"><i class="fa fa-info-circle me-2" style="color:#0e7490;"></i>How It Works</h2>
            </div>
            <div class="post-cargo-body">
                <div class="auth-info-banner" style="margin:0;">
                    <strong><i class="fa fa-lock me-1"></i>Two-phase onboarding</strong>
                    You enter the driver's official details here. The driver then goes to the Register page,
                    enters their National ID number to find this profile, confirms their email, and sets a password.
                    Only then is their account activated.
                </div>
                <div class="auth-info-banner mt-3" style="margin:0;">
                    <strong><i class="fa fa-shield-alt me-1"></i>What you control</strong>
                    You control the driver's name, ID, licence, phone and email on record.
                    Drivers cannot change their own identity or fleet details — only their password.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
