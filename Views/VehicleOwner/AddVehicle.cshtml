@model VehicleDetailViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Add Vehicle";
    var companies = ViewBag.Companies as List<SelectListItem> ?? new List<SelectListItem>();
}

<div class="dash-page-header">
    <div>
        <h1><i class="fa fa-truck me-2" style="color:#d4890a;font-size:20px;"></i>Add Vehicle</h1>
        <p class="dash-page-header__sub">Select the company this vehicle belongs to and capture the registration details.</p>
    </div>
</div>

<div class="dash-panel">
    <div class="dash-panel__header">
        <h2 class="dash-panel__title">Vehicle Details</h2>
    </div>

    <form asp-action="AddVehicle" method="post" enctype="multipart/form-data" class="row g-3">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="col-md-6">
            <label asp-for="CompanyId" class="form-label"></label>
            <select asp-for="CompanyId" asp-items="companies" class="form-select">
                <option value="">-- Select the company this vehicle belongs to --</option>
            </select>
            <span asp-validation-for="CompanyId" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="VehicleType" class="form-label"></label>
            <input asp-for="VehicleType" class="form-control" placeholder="e.g. Canter, Flatbed, Truck" />
            <span asp-validation-for="VehicleType" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="RegistrationNumber" class="form-label"></label>
            <input asp-for="RegistrationNumber" class="form-control" />
            <span asp-validation-for="RegistrationNumber" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="InsuranceDocument" class="form-label"></label>
            <input asp-for="InsuranceDocument" type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" />
            <span asp-validation-for="InsuranceDocument" class="text-danger"></span>
            <small class="form-text text-muted">PDF, JPG, or PNG up to 10 MB.</small>
        </div>

        <div class="col-md-6">
            <label asp-for="InsuranceExpiryDate" class="form-label"></label>
            <input asp-for="InsuranceExpiryDate" type="date" class="form-control" />
            <span asp-validation-for="InsuranceExpiryDate" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="InspectionReport" class="form-label"></label>
            <input asp-for="InspectionReport" type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" />
            <span asp-validation-for="InspectionReport" class="text-danger"></span>
            <small class="form-text text-muted">PDF, JPG, or PNG up to 10 MB.</small>
        </div>

        <div class="col-md-6">
            <label asp-for="InspectionExpiryDate" class="form-label"></label>
            <input asp-for="InspectionExpiryDate" type="date" class="form-control" />
            <span asp-validation-for="InspectionExpiryDate" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Capacity" class="form-label"></label>
            <input asp-for="Capacity" type="number" min="0.01" step="0.01" class="form-control" />
            <span asp-validation-for="Capacity" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="LastCargoTransported" class="form-label"></label>
            <input asp-for="LastCargoTransported" class="form-control" />
            <span asp-validation-for="LastCargoTransported" class="text-danger"></span>
        </div>

        <div class="col-12 d-flex justify-content-between align-items-center mt-4">
            <a asp-action="Vehicles" class="btn btn-outline-secondary">Back to Vehicles</a>
            <button type="submit" class="btn btn-primary">Save Vehicle</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
