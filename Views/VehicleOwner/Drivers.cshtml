@model List<DriverRowViewModel>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Drivers";
    var filter = ViewData["Filter"] as string;
}

@@section Styles {
    <style>
        .driver-filter-strip {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 6px;
            padding: 6px;
            background: #fff;
            border: 1px solid #e8eceb;
            border-radius: 8px;
        }

        .driver-filter {
            min-width: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            padding: 9px 12px;
            border: 1px solid transparent;
            border-radius: 6px;
            color: #59645f;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            white-space: nowrap;
            transition: background-color .15s ease, border-color .15s ease, color .15s ease;
        }

        .driver-filter:hover {
            background: #f5f7f6;
            color: #1a3c5e;
            text-decoration: none;
        }

        .driver-filter.active {
            background: #eef3f7;
            border-color: #d8e2e9;
            color: #1a3c5e;
        }

        .driver-filter__count {
            min-width: 27px;
            height: 27px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 7px;
            border-radius: 5px;
            background: #f0f2f1;
            color: #46514c;
            font-size: 12px;
            font-weight: 700;
            font-variant-numeric: tabular-nums;
        }

        .driver-filter.active .driver-filter__count {
            background: #1a3c5e;
            color: #fff;
        }

        @@media (max-width: 640px) {
            .driver-filter-strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }
    </style>
}

<div class="dash-page-header">
    <div>
        <h1><i class="fa fa-id-card me-2" style="color:#1a3c5e;font-size:20px;"></i>Drivers</h1>
        <p class="dash-page-header__sub">All drivers registered under your fleet.</p>
    </div>
    <div class="dash-page-header__actions">
        <a asp-action="AddDriver" class="dash-btn dash-btn--primary">
            <i class="fa fa-plus"></i> Add Driver
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="dash-alert dash-alert--success mb-4">
        <i class="fa fa-check-circle me-2"></i> @TempData["Success"]
    </div>
}

<nav class="driver-filter-strip mb-4" aria-label="Filter drivers">
    <a asp-action="Drivers" aria-current="@(filter == null ? "page" : null)" class="driver-filter @(filter == null ? "active" : "")">
        <span>All</span>
        <span class="driver-filter__count">@Model.Count</span>
    </a>
    <a asp-action="Drivers" asp-route-filter="verified" aria-current="@(filter == "verified" ? "page" : null)" class="driver-filter @(filter == "verified" ? "active" : "")">
        <span>Verified</span>
        <span class="driver-filter__count">@Model.Count(d => d.IsVerified)</span>
    </a>
    <a asp-action="Drivers" asp-route-filter="claimed" aria-current="@(filter == "claimed" ? "page" : null)" class="driver-filter @(filter == "claimed" ? "active" : "")">
        <span>Claimed</span>
        <span class="driver-filter__count">@Model.Count(d => d.HasAccount)</span>
    </a>
    <a asp-action="Drivers" asp-route-filter="unclaimed" aria-current="@(filter == "unclaimed" ? "page" : null)" class="driver-filter @(filter == "unclaimed" ? "active" : "")">
        <span>Unclaimed</span>
        <span class="driver-filter__count">@Model.Count(d => !d.HasAccount)</span>
    </a>
</nav>

<div class="dash-panel">
    <div class="dash-panel__header">
        <h2 class="dash-panel__title">@(filter != null ? $"Showing: {filter}" : "All Drivers")</h2>
    </div>
    @if (!Model.Any())
    {
        <div class="dash-empty">
            <i class="fa fa-id-card"></i>
            <p>No drivers found. Add a driver to get started.</p>
            <a asp-action="AddDriver" class="dash-btn dash-btn--primary"><i class="fa fa-plus"></i> Add Driver</a>
        </div>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table class="dash-table">
                <thead>
                    <tr>
                        <th>Full Name</th>
                        <th>ID Number</th>
                        <th>Phone</th>
                        <th>Licence No.</th>
                        <th>Assigned Vehicle</th>
                        <th>Account</th>
                        <th>Status</th>
                        <th>Registered</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td class="td-primary">@d.FullName</td>
                            <td class="td-muted">@d.IdNumber</td>
                            <td class="td-muted">@d.PhoneNumber</td>
                            <td class="td-muted">@d.LicenseNumber</td>
                            <td class="td-muted">@(d.VehicleNumberPlate ?? "Not assigned")</td>
                            <td>
                                @if (d.HasAccount)
                                {
                                    <span class="dash-stat-card__badge dash-stat-card__badge--green">
                                        <i class="fa fa-check me-1"></i> Yes
                                    </span>
                                }
                                else
                                {
                                    <span class="dash-stat-card__badge dash-stat-card__badge--amber">
                                        <i class="fa fa-clock me-1"></i> Pending
                                    </span>
                                }
                            </td>
                            <td>
                                @if (d.IsVerified)
                                {
                                    <span class="status-pill status-pill--accepted">Verified</span>
                                }
                                else
                                {
                                    <span class="status-pill status-pill--pending">Unverified</span>
                                }
                            </td>
                            <td class="td-muted">@d.CreatedAt.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Styles {
<style>.dash-alert--success { background:#e6f4ee;color:#1a7a45;border:1px solid #b7dfc8; }</style>
}
